# --- pull-up: a lone wrapped predicate under a join is lifted (speculative pre-filter at the leaf) and
# --- hoisted as a single-leaf node region --------------------------------------------------------------
statement ok
CREATE TABLE picks AS SELECT range*20 AS id FROM range(10);

query II
EXPLAIN SELECT count(*) FROM docs JOIN picks USING (id) WHERE lower(ai_complete('Return a single yes or no. [p=40] relevant? '||txt)) IN ('yes','true');
----
physical_plan	<REGEX>:(?s).*ai_function_with_embed\('L0'.*speculative_ai_function_with_embed\('L0'.*Does the completion satisfy.*

statement ok
SELECT ai_usage_reset();

statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM docs JOIN picks USING (id) WHERE lower(ai_complete('Return a single yes or no. [p=40] relevant? '||txt)) IN ('yes','true');
----
4

# only the 10 join survivors are asked
query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
10

statement ok
SET ai_pullup = false;

statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM docs JOIN picks USING (id) WHERE lower(ai_complete('Return a single yes or no. [p=40] relevant? '||txt)) IN ('yes','true');
----
4

statement ok
RESET ai_pullup;

# --- a wrapped PAIR predicate over a cross product reaches the factor graph ---------------------------
statement ok
CREATE TABLE d20 AS SELECT * FROM docs WHERE id < 20;

query II
EXPLAIN SELECT count(*) FROM d20 d, qs q WHERE lower(ai_complete('Return a single yes or no. [p=35] does '||d.txt||' answer '||q.q||'?')) IN ('yes','true');
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*

statement ok
SELECT ai_usage_reset();

statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM d20 d, qs q WHERE lower(ai_complete('Return a single yes or no. [p=35] does '||d.txt||' answer '||q.q||'?')) IN ('yes','true');
----
32

# one call per distinct pair
query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
80

statement ok
SET ai_join_factorize = 'off';

statement ok
SET ai_pullup = false;

statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM d20 d, qs q WHERE lower(ai_complete('Return a single yes or no. [p=35] does '||d.txt||' answer '||q.q||'?')) IN ('yes','true');
----
32

statement ok
RESET ai_join_factorize;

statement ok
RESET ai_pullup;

# --- a wrapper that raises on the answer (strict cast of 'yes'/'no') fails the query exactly as the
# --- scalar does, instead of dropping rows or killing a worker thread ----------------------------------
statement error
SELECT count(*) FROM docs WHERE (ai_complete('Return a single yes or no. [p=50] n? '||txt))::INTEGER > 3 AND ai_filter('[p=90] long? '||txt);
----
<REGEX>:.*Could not convert string.*

statement ok
SET ai_reorder = false;

statement error
SELECT count(*) FROM docs WHERE (ai_complete('Return a single yes or no. [p=50] n? '||txt))::INTEGER > 3 AND ai_filter('[p=90] long? '||txt);
----
<REGEX>:.*Could not convert string.*

statement ok
RESET ai_reorder;

# --- a column reference next to the call is NOT a leaf: the predicate stays a plain filter ------------
query II
EXPLAIN SELECT count(*) FROM docs WHERE lower(ai_complete('Return a single yes or no. [p=50] n? '||txt)) = txt AND ai_filter('[p=90] long? '||txt);
----
physical_plan	<!REGEX>:(?s).*ai_function_with_embed.*

query I
SELECT count(*) FROM docs WHERE lower(ai_complete('Return a single yes or no. [p=50] n? '||txt)) = txt AND ai_filter('[p=90] long? '||txt);
----
0

statement ok
CALL ai_mock_stop();

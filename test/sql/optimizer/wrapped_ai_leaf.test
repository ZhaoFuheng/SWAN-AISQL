statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM docs WHERE NOT (length(ai_complete('Return a single yes or no. [p=30] short? '||txt)) = 2) AND ai_filter('[p=90] long? '||txt);
----
51

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT < 400 FROM ai_usage();
----
true

statement ok
SET ai_reorder = false;

statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM docs WHERE NOT (length(ai_complete('Return a single yes or no. [p=30] short? '||txt)) = 2) AND ai_filter('[p=90] long? '||txt);
----
51

statement ok
RESET ai_reorder;

# --- CASE over the SAME call twice (try_cast + comparison): still one leaf, one call per input --------
query II
EXPLAIN SELECT count(*) FROM docs WHERE CASE WHEN try_cast(ai_complete('Return a single yes or no. [p=50] n? '||txt) AS INTEGER) IS NULL THEN lower(ai_complete('Return a single yes or no. [p=50] n? '||txt)) = 'yes' ELSE false END AND ai_filter('[p=90] long? '||txt);
----
physical_plan	<REGEX>:(?s).*ai_function_with_embed\('A\(L0,L1\)'.*

statement ok
SELECT ai_usage_reset();

statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM docs WHERE CASE WHEN try_cast(ai_complete('Return a single yes or no. [p=50] n? '||txt) AS INTEGER) IS NULL THEN lower(ai_complete('Return a single yes or no. [p=50] n? '||txt)) = 'yes' ELSE false END AND ai_filter('[p=90] long? '||txt);
----
93

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT < 400 FROM ai_usage();
----
true

statement ok
SET ai_reorder = false;

statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM docs WHERE CASE WHEN try_cast(ai_complete('Return a single yes or no. [p=50] n? '||txt) AS INTEGER) IS NULL THEN lower(ai_complete('Return a single yes or no. [p=50] n? '||txt)) = 'yes' ELSE false END AND ai_filter('[p=90] long? '||txt);
----
93

statement ok
RESET ai_reorder;


# name: test/sql/pullup/lift_through_semi_join.test
# description: An AI predicate commutes with every operator that preserves its side -- IN / EXISTS (semi),
# group: [pullup]

#              NOT IN / NOT EXISTS (anti, mark) -- so it runs on the rows the subquery keeps, not on the base
#              table DuckDB's push-down left it on (SWAN 2.0 football-16: 296 calls for 22 survivors).
#              Pull-up is the inverse of push-down: a per-operator commutation law, not a query shape.

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE t AS SELECT range AS id, 'name '||range::VARCHAR AS nm FROM range(200);

# 10 ids carry cls = 7
statement ok
CREATE TABLE attr AS SELECT range AS id, range % 20 AS cls FROM range(200);

statement ok
SET ai_speculative=false;

# --- IN (subquery): a RIGHT_SEMI join; the predicate lifts above it and sees the 10 survivors
statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE r_in AS
SELECT nm FROM t WHERE ai_filter('[p=50] ok? '||nm) AND id IN (SELECT id FROM attr WHERE cls = 7);

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
10

query II
EXPLAIN SELECT nm FROM t WHERE ai_filter('[p=50] ok? '||nm) AND id IN (SELECT id FROM attr WHERE cls = 7);
----
physical_plan	<REGEX>:(?s).*Ai Region.*Join Type: (RIGHT_)?SEMI.*

# --- EXISTS (correlated): the same semi join after decorrelation
statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE r_exists AS
SELECT nm FROM t WHERE ai_filter('[p=50] ok? '||nm)
  AND EXISTS (SELECT 1 FROM attr a WHERE a.id = t.id AND a.cls = 7);

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
10

# --- NOT IN: anti / mark join; the predicate lifts above it and sees the 190 survivors
statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE r_not_in AS
SELECT nm FROM t WHERE ai_filter('[p=50] ok? '||nm) AND id NOT IN (SELECT id FROM attr WHERE cls = 7);

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
190

# --- parity: with the lift off the same rows come back
statement ok
SET ai_pullup=false;

statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE r_in_off AS
SELECT nm FROM t WHERE ai_filter('[p=50] ok? '||nm) AND id IN (SELECT id FROM attr WHERE cls = 7);

query I
SELECT count(*) FROM ((SELECT * FROM r_in EXCEPT SELECT * FROM r_in_off)
                      UNION ALL (SELECT * FROM r_in_off EXCEPT SELECT * FROM r_in));
----
0

statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE r_not_in_off AS
SELECT nm FROM t WHERE ai_filter('[p=50] ok? '||nm) AND id NOT IN (SELECT id FROM attr WHERE cls = 7);

query I
SELECT count(*) FROM ((SELECT * FROM r_not_in EXCEPT SELECT * FROM r_not_in_off)
                      UNION ALL (SELECT * FROM r_not_in_off EXCEPT SELECT * FROM r_not_in));
----
0

statement ok
SET ai_pullup=true;

# --- the default (speculative on) never asks more than the full table and keeps the result
statement ok
SET ai_speculative=true;

statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE r_in_spec AS
SELECT nm FROM t WHERE ai_filter('[p=50] ok? '||nm) AND id IN (SELECT id FROM attr WHERE cls = 7);

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT <= 200 FROM ai_usage();
----
true

query I
SELECT count(*) FROM ((SELECT * FROM r_in EXCEPT SELECT * FROM r_in_spec)
                      UNION ALL (SELECT * FROM r_in_spec EXCEPT SELECT * FROM r_in));
----
0

# name: test/sql/pullup/volatile_rewrites.test
# description: A rewrite that would re-evaluate a volatile expression (nextval, random) declines: forced CTE
# group: [pullup]

#              inlining, the reducer's neighbour copy, the demand reduction's key-source copy and the INNER->SEMI
#              conversion. And the demand reduction never cuts below an operator that counts the rows it would
#              remove (a window). Each answer is the one native evaluation gives.

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE d AS SELECT i AS id, 'd' || i AS body FROM range(1, 4) r(i);

# (a) an explicitly MATERIALIZED AI CTE with nextval(): both references must see the same values
statement ok
CREATE SEQUENCE s_inline START 1;

query II
WITH c AS MATERIALIZED (SELECT id, nextval('s_inline') AS v FROM d WHERE ai_filter('[p=100] ' || body))
SELECT count(*) FILTER (WHERE c1.v = c2.v), count(*) FROM c c1 JOIN c c2 USING (id);
----
3	3

# (b) a neighbour whose join key is drawn from a sequence: a copy would draw other keys and reduce docs to nothing
statement ok
CREATE SEQUENCE s_keys START 1;

query I
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] keys ' || body)) dd JOIN (SELECT nextval('s_keys') AS id FROM range(3)) nb USING (id);
----
3

# (c) DISTINCT over a join with a volatile projection: every joined duplicate is a distinct row (9, not 3)
statement ok
CREATE SEQUENCE s_distinct START 1;

statement ok
CREATE TABLE circuits AS SELECT i AS circuit_id, 'c' || i AS name FROM range(1, 4) r(i);

statement ok
CREATE TABLE races AS SELECT i AS race_id, 1 + (i % 3) AS circuit_id FROM range(1, 10) r(i);

query I
SELECT count(*) FROM (SELECT DISTINCT c.name, nextval('s_distinct') AS v FROM circuits c JOIN races r ON r.circuit_id = c.circuit_id WHERE ai_filter('[p=100] Is it a street circuit? name: ' || c.name));
----
9

# the same DISTINCT without the volatile column still converts and dedups
query I
SELECT count(*) FROM (SELECT DISTINCT c.name FROM circuits c JOIN races r ON r.circuit_id = c.circuit_id WHERE ai_filter('[p=100] Is it a street circuit? name: ' || c.name));
----
3

# (d) demand reduction below a window: id 2 is the second passer whatever the join keeps
statement ok
SET ai_inline_ai_ctes = false;

statement ok
CREATE TABLE hot AS SELECT 2 AS id;

query I
WITH c AS MATERIALIZED (SELECT id, row_number() OVER (ORDER BY id) AS rn FROM d WHERE ai_filter('[p=100] window ' || body))
SELECT c.rn FROM c JOIN hot USING (id);
----
2

# (e) and with inlining off, a volatile body is neither inlined nor reduced: one draw per row, shared by the join
statement ok
CREATE SEQUENCE s_demand START 1;

query II
WITH c AS MATERIALIZED (SELECT id, nextval('s_demand') AS v FROM d WHERE ai_filter('[p=100] demand ' || body))
SELECT count(*) FILTER (WHERE c1.v = c2.v), count(*) FROM c c1 JOIN c c2 USING (id);
----
3	3

# (f) a volatile PROMPT is neither hoisted into a region nor pulled above a join: it runs once per base row,
# as written (every duplicate of an id then shares that row's single draw through the join)
query I
SELECT count(*) FROM d JOIN (SELECT 1 AS id UNION ALL SELECT 1 UNION ALL SELECT 2) f USING (id) WHERE ai_filter('[p=100] ' || body || (random() > 2)::VARCHAR);
----
3

# (g) the draw sits in the CTE's GROUP BY, not its select list: the body is still volatile, still not inlined
statement ok
CREATE SEQUENCE s_group START 1;

query I
WITH c AS MATERIALIZED (SELECT nextval('s_group') AS g, count(*) AS n FROM d WHERE ai_filter('[p=100] group ' || body) GROUP BY 1)
SELECT count(*) FROM c c1 JOIN c c2 USING (g);
----
3

# (h) and inside a lambda body, which is not among an expression's children
statement ok
CREATE SEQUENCE s_lambda START 1;

query I
WITH c AS MATERIALIZED (SELECT id, list_transform([id], lambda x: x + nextval('s_lambda'))[1] AS v FROM d WHERE ai_filter('[p=100] lambda ' || body))
SELECT count(*) FILTER (WHERE c1.v = c2.v) FROM c c1 JOIN c c2 USING (id);
----
3

# (i) the REDUCED side's join key is drawn above its ai_filter: the semi-join may not copy the draw below
# the projection (ids 1..10 are drawn once; the join keeps 1..3)
statement ok
CREATE SEQUENCE s_drawn START 1;

statement ok
CREATE TABLE big AS SELECT i AS id, 'b' || i AS body FROM range(1, 11) r(i);

query I
SELECT count(*) FROM (SELECT nextval('s_drawn') AS id FROM big WHERE ai_filter('[p=100] drawn ' || body)) dd JOIN (SELECT i AS id FROM range(1, 4) r(i)) nb USING (id);
----
3

# (j) a materialized key CTE whose keys are drawn: the demand reduction must not copy its body either
statement ok
CREATE SEQUENCE s_keycte START 1;

query I
WITH k AS MATERIALIZED (SELECT nextval('s_keycte') AS id FROM range(3)),
     c AS MATERIALIZED (SELECT id FROM d WHERE ai_filter('[p=100] keycte ' || body))
SELECT count(*) FROM c JOIN k USING (id);
----
3

statement ok
SET ai_inline_ai_ctes = true;

# (k) a volatile filter ABOVE the join: 6 of the 9 joined rows pass, every name among them; a SEMI
# conversion would draw only 3 times and pass none
statement ok
CREATE SEQUENCE s_above START 1;

query I
SELECT count(*) FROM (SELECT DISTINCT c.name FROM circuits c JOIN races r ON r.circuit_id = c.circuit_id WHERE ai_filter('[p=100] Is it a street circuit? name: ' || c.name) AND nextval('s_above') > 3);
----
3

# (l) a region pushed below a cross product may not inline the projection's draw into the prompt: the six
# output rows draw six values, once each, and the prompt sees the displayed one
statement ok
CREATE SEQUENCE s_push START 1;

statement ok
CREATE TABLE f AS SELECT i AS fid FROM range(1, 3) r(i);

statement ok
CREATE TABLE pushed AS SELECT v, ai_complete('[p=100] echo ' || txt || ' v=' || v::VARCHAR) AS a FROM (SELECT d.body AS txt, nextval('s_push') AS v FROM d CROSS JOIN f) q;

query II
SELECT nextval('s_push') - 1, (SELECT count(DISTINCT v) FROM pushed);
----
6	6

# (m) the draw in an aggregate's GROUP BY list, the aggregate directly on the join: four joined rows, four groups
statement ok
CREATE SEQUENCE s_group_join START 1;

statement ok
CREATE TABLE races2 AS SELECT i AS race_id, i AS circuit_id FROM range(1, 3) r(i);

statement ok
CREATE TABLE circuits2 AS SELECT 1 + (i % 2) AS circuit_id, 'c' || i AS name FROM range(4) r(i);

query I
SELECT count(*) FROM (SELECT nextval('s_group_join') AS g, min(ai_complete('[p=100] r ' || r.race_id::VARCHAR)) AS m FROM races2 r JOIN circuits2 c ON c.circuit_id = r.circuit_id GROUP BY g);
----
4

# (n) two AI predicates, one prompt draws: the fold would evaluate the prompt a second time for its features;
# three rows, three draws
statement ok
CREATE SEQUENCE s_fold START 1;

query I
SELECT count(*) FROM d WHERE ai_filter('[p=100] a ' || body || ' ' || nextval('s_fold')::VARCHAR) AND ai_filter('[p=100] b ' || body);
----
3

query I
SELECT nextval('s_fold') - 1;
----
3

# (o) the pull-up may not cross a projection that draws: rejected rows must not consume sequence values,
# so the one passer gets v = 1 (lifted above the projection, every row joined by hot would draw first)
statement ok
CREATE SEQUENCE s_cross START 1;

statement ok
CREATE TABLE hot2 AS SELECT 1 AS id UNION ALL SELECT 2;

query I
SELECT q.v FROM (SELECT id, nextval('s_cross') AS v FROM d WHERE ai_filter(CASE WHEN id = 1 THEN '[p=100] keep ' ELSE '[p=0] drop ' END || body)) q JOIN hot2 USING (id);
----
1

query I
SELECT nextval('s_cross') - 1;
----
1

# (p) a mixed node (ai_filter with a draw AND ai_complete <> '') is not built either: three rows, three draws
statement ok
CREATE SEQUENCE s_mixed START 1;

query I
SELECT count(*) FROM d WHERE ai_filter('[p=100] a ' || body || ' ' || nextval('s_mixed')::VARCHAR) AND ai_complete('[p=100] c ' || body) <> '';
----
3

query I
SELECT nextval('s_mixed') - 1;
----
3

# (q) nor the LIMIT pass's node, over two leaves or one
statement ok
CREATE SEQUENCE s_limit START 1;

query I
SELECT count(*) FROM (SELECT * FROM d WHERE ai_filter('[p=100] a ' || body || ' ' || nextval('s_limit')::VARCHAR) AND ai_filter('[p=100] b ' || body) LIMIT 3);
----
3

query I
SELECT count(*) FROM (SELECT * FROM d WHERE ai_filter('[p=100] lone ' || body || ' ' || nextval('s_limit')::VARCHAR) LIMIT 3);
----
3

query I
SELECT nextval('s_limit') - 1;
----
6

# (r) an AI join condition that draws stays in the join: evaluated once for the (a, b) pair, not once per
# duplicate the outer join above makes of it (both duplicates keep the pair's single verdict)
statement ok
CREATE SEQUENCE s_joincond START 1;

statement ok
CREATE TABLE ja AS SELECT 1 AS id, 'a' AS x;

statement ok
CREATE TABLE jb AS SELECT 1 AS id, 'b' AS y;

statement ok
CREATE TABLE jc AS SELECT 1 AS id, 'c1' AS z UNION ALL SELECT 1, 'c2';

query I
SELECT count(*) FROM (ja JOIN jb ON ja.id = jb.id AND ai_filter(CASE WHEN nextval('s_joincond') = 1 THEN '[p=100] ' ELSE '[p=0] ' END || ja.x || jb.y)) LEFT JOIN jc ON ja.id = jc.id WHERE coalesce(jc.z, '') <> 'zz';
----
2

query I
SELECT nextval('s_joincond') - 1;
----
1

# (s) the same for a join on the AI condition alone
statement ok
CREATE SEQUENCE s_anyjoin START 1;

query I
SELECT count(*) FROM (ja JOIN jb ON ai_filter(CASE WHEN nextval('s_anyjoin') = 1 THEN '[p=100] ' ELSE '[p=0] ' END || ja.x || jb.y)) LEFT JOIN jc ON ja.id = jc.id WHERE coalesce(jc.z, '') <> 'zz';
----
2

query I
SELECT nextval('s_anyjoin') - 1;
----
1

# and without the draw the condition is still lifted and deduplicated: one call for the pair
statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FROM (ja JOIN jb ON ai_filter('[p=100] lifted ' || ja.x || jb.y)) LEFT JOIN jc ON ja.id = jc.id WHERE coalesce(jc.z, '') <> 'zz';
----
2

query I
SELECT sum(llm_calls) FROM ai_usage();
----
1

# (t) the reducer's descent stops at an operator that draws, key or not: every passer draws (1, 2, 3) and the
# join keeps ids 1 and 3 with their own draws. A SEMI under the projection would let only 1 and 3 draw ([1, 2]).
# (DuckDB's own dynamic join filter prunes the scan below such a projection when the build side is small, so
# this is the per-row answer, not a native-DuckDB one.)
statement ok
CREATE SEQUENCE s_desc START 1;

statement ok
CREATE TABLE odd AS SELECT * FROM (VALUES (1), (3)) t(id);

query I
SELECT list(v ORDER BY v) FROM (SELECT id, nextval('s_desc') AS v FROM d WHERE ai_filter('[p=100] desc ' || body)) a JOIN odd USING (id);
----
[1, 3]

# (u) and a filter that draws on the path: per row, ids 1 and 3 draw odd numbers and both have a partner; a SEMI
# under the filter would hand id 3 the second draw and drop it (1)
statement ok
CREATE SEQUENCE s_descf START 1;

query I
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] descf ' || body) AND nextval('s_descf') % 2 = 1) a JOIN odd USING (id);
----
2

# (x) a drawing AI predicate beside two safe ones: the safe pair still folds into one node, the drawing one
# stays a filter expression of its own (three rows, three draws)
statement ok
CREATE SEQUENCE s_partial START 1;

query II
EXPLAIN SELECT count(*) FROM d WHERE ai_filter('[p=100] fa ' || body) AND ai_filter('[p=100] fb ' || body) AND ai_filter('[p=100] fc ' || body || nextval('s_partial')::VARCHAR);
----
physical_plan	<REGEX>:(?s).*ai_function_with_embed.*

query I
SELECT count(*) FROM d WHERE ai_filter('[p=100] fa ' || body) AND ai_filter('[p=100] fb ' || body) AND ai_filter('[p=100] fc ' || body || nextval('s_partial')::VARCHAR);
----
3

query I
SELECT nextval('s_partial') - 1;
----
3

# (v) a volatile term BESIDE a call does not block the call's region: over a 3,000-row fan-out the call runs once
# per distinct body (3 calls, no per-row cache hits), as it does without the term
statement ok
CREATE TABLE fan AS SELECT i FROM range(1000) t(i);

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FILTER (WHERE x) FROM (SELECT ai_filter('[p=100] beside ' || d.body) OR random() < 2 AS x FROM d, fan);
----
3000

query II
SELECT sum(llm_calls), sum(cache_hits) FROM ai_usage();
----
3	0

# (w) an AI call inside a lambda body: DuckDB binds the lambda function VOLATILE from its body, which must not
# read as a draw -- the call is deduplicated over the fan-out exactly like the same nested call without a lambda
statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FILTER (WHERE x) FROM (SELECT ai_filter('[p=100] nest ' || ai_complete('norm ' || d.body)) AS x FROM d, fan);
----
3000

query II
SELECT sum(llm_calls), sum(cache_hits) FROM ai_usage();
----
4	2

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FILTER (WHERE x) FROM (SELECT ai_filter('[p=100] lam ' || list_aggregate(list_transform([d.body], lambda y: ai_complete('norm ' || y)), 'string_agg')) AS x FROM d, fan);
----
3000

query II
SELECT sum(llm_calls), sum(cache_hits) FROM ai_usage();
----
4	2

# while a draw inside the body still counts as one: every row draws its own prompt
statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FILTER (WHERE x) FROM (SELECT ai_filter('[p=100] lamdraw ' || list_aggregate(list_transform([d.body], lambda y: y || random()::VARCHAR), 'string_agg')) AS x FROM d, fan);
----
3000

query I
SELECT sum(llm_calls) FROM ai_usage();
----
3000

# (y) a CASE branch above a join keeps its laziness: the call is asked only for rows that select the branch
# (one prompt, one call; a region over the fan-out would ask every body), and an expression beside it that
# throws on a skipped row (CAST of 'bad') never runs there
statement ok
CREATE TABLE dt AS SELECT i AS id, 'd' || i AS body, CASE WHEN i = 2 THEN 'bad' ELSE i::VARCHAR END AS txt FROM range(1, 4) r(i);

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FILTER (WHERE x) FROM (SELECT CASE WHEN dt.id = 1 THEN ai_filter('[p=100] branch ' || dt.body) ELSE false END AS x FROM dt, fan);
----
1000

query I
SELECT sum(llm_calls) FROM ai_usage();
----
1

query I
SELECT count(*) FILTER (WHERE x) FROM (SELECT CASE WHEN dt.txt <> 'bad' THEN ai_filter('[p=100] cast ' || CAST(dt.txt AS INTEGER)::VARCHAR) ELSE false END AS x FROM dt, fan);
----
2000

# (z) an unseeded SAMPLE neighbour draws: a copy would draw another row and reduce the passers to none. Every
# sampled id has a passer, so the join keeps exactly one row whichever row is drawn (three draws)
statement ok
CREATE TABLE pool AS SELECT i AS id FROM range(1, 4) t(i);

query I
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] smp ' || body)) a JOIN (SELECT id FROM pool USING SAMPLE 1 ROWS) s USING (id);
----
1

query I
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] smp ' || body)) a JOIN (SELECT id FROM pool USING SAMPLE 1 ROWS) s USING (id);
----
1

query I
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] smp ' || body)) a JOIN (SELECT id FROM pool USING SAMPLE 1 ROWS) s USING (id);
----
1

# a sampled MATERIALIZED CTE referenced twice is drawn once: both references see the same row
query I
WITH c AS MATERIALIZED (SELECT id FROM pool USING SAMPLE 1 ROWS)
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] cte ' || body)) a JOIN c USING (id) JOIN c c2 USING (id);
----
1

query I
WITH c AS MATERIALIZED (SELECT id FROM pool USING SAMPLE 1 ROWS)
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] cte ' || body)) a JOIN c USING (id) JOIN c c2 USING (id);
----
1

query I
WITH c AS MATERIALIZED (SELECT id FROM pool USING SAMPLE 1 ROWS)
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] cte ' || body)) a JOIN c USING (id) JOIN c c2 USING (id);
----
1

# a seeded sample is repeatable, so its copy is still reduced by (one row)
query I
SELECT count(*) FROM (SELECT id FROM d WHERE ai_filter('[p=100] seeded ' || body)) a JOIN (SELECT id FROM pool USING SAMPLE 1 ROWS (reservoir, 7)) s USING (id);
----
1

statement ok
CALL ai_mock_stop();

# name: test/sql/pullup/pullup_through_unnest.test
# description: A semantic filter lifts through an UNNEST. UNNEST repeats its input's columns per element and drops
# group: [pullup]

#              a row whose list is empty or NULL, so a filter on those columns returns the same rows above it, and
#              above it the rows with nothing to unnest (and those the filter on the elements drops) are never
#              asked. The lateral unnest of an AI CTE becomes an UNNEST under ai_lateral_unnest (agent_bench Q24:
#              62 calls where 59 businesses produce a category). Same rows as with the pull-up off.

require aisql

statement ok
CALL ai_mock_start();

# 100 businesses: 15 with no category list, 8 more whose list holds only blanks
statement ok
CREATE TABLE biz AS SELECT 'b_'||i::VARCHAR AS id,
       CASE WHEN i % 7 = 0 THEN NULL WHEN i % 11 = 0 THEN ' , ' ELSE 'cafe, bar, '||(i%3)::VARCHAR END AS cats
FROM range(100) r(i);

# the businesses that produce at least one category
query I
SELECT count(*) FROM biz WHERE list_count(list_filter(string_split(cats, ','), lambda x: trim(x) <> '')) > 0;
----
77

statement ok
SELECT ai_usage_reset(), ai_local_cache_clear();

statement ok
CREATE TABLE r_on AS
WITH s AS (SELECT id, cats FROM biz WHERE ai_filter('[p=60] lists several services? '||id)),
     tok AS (SELECT s.id, trim(t.v) AS category FROM s, LATERAL UNNEST(string_split(s.cats, ',')) AS t(v)
             WHERE trim(t.v) <> '')
SELECT id, category FROM tok;

# one call per business with a category to emit
query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
77

statement ok
SET ai_pullup = false;

statement ok
SELECT ai_usage_reset(), ai_local_cache_clear();

statement ok
CREATE TABLE r_off AS
WITH s AS (SELECT id, cats FROM biz WHERE ai_filter('[p=60] lists several services? '||id)),
     tok AS (SELECT s.id, trim(t.v) AS category FROM s, LATERAL UNNEST(string_split(s.cats, ',')) AS t(v)
             WHERE trim(t.v) <> '')
SELECT id, category FROM tok;

# without the lift every business is asked
query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
100

query I
SELECT count(*) FROM ((SELECT * FROM r_on EXCEPT ALL SELECT * FROM r_off) UNION ALL (SELECT * FROM r_off EXCEPT ALL SELECT * FROM r_on));
----
0

query I
SELECT count(*) > 0 FROM r_on;
----
true

# === a list projection that uses regexp_replace (agent_bench Q21's normalized_categories) ===
# DuckDB registers regexp_replace as able to throw and, unlike regexp_extract, keeps that for a constant
# pattern; the pull-up treats a constant pattern and replacement as safe, so the lift still happens.
statement ok
SET ai_pullup = true;

statement ok
SELECT ai_usage_reset(), ai_local_cache_clear();

statement ok
CREATE TABLE r_re AS
WITH s AS (SELECT id, cats FROM biz WHERE ai_filter('[p=60] lists several services? '||id)),
     norm AS (SELECT id, regexp_replace(coalesce(regexp_extract(cats, '^(.*)$', 1), ''), '^cafe, ', '') AS raw FROM s),
     tok AS (SELECT n.id, trim(t.v) AS category FROM norm n, LATERAL UNNEST(string_split(n.raw, ',')) AS t(v)
             WHERE trim(t.v) <> '')
SELECT id, category FROM tok;

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
77

# the global-replace option is a constant too
statement ok
SELECT ai_usage_reset(), ai_local_cache_clear();

statement ok
CREATE TABLE r_re_g AS
WITH s AS (SELECT id, cats FROM biz WHERE ai_filter('[p=60] lists several services? '||id)),
     norm AS (SELECT id, regexp_replace(cats, 'a', 'A', 'g') AS raw FROM s),
     tok AS (SELECT n.id, trim(t.v) AS category FROM norm n, LATERAL UNNEST(string_split(n.raw, ',')) AS t(v)
             WHERE trim(t.v) <> '')
SELECT id, category FROM tok;

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
77

query I
SELECT count(*) FROM r_re_g WHERE category LIKE '%a%';
----
0

# control: a pattern read from a column can throw on a data row, so the predicate stays below the UNNEST
statement ok
SELECT ai_usage_reset(), ai_local_cache_clear();

statement ok
CREATE TABLE r_re_col AS
WITH s AS (SELECT id, cats FROM biz WHERE ai_filter('[p=60] lists several services? '||id)),
     norm AS (SELECT id, regexp_replace(cats, cats, '') AS raw FROM s),
     tok AS (SELECT n.id, trim(t.v) AS category FROM norm n, LATERAL UNNEST(string_split(n.raw, ',')) AS t(v)
             WHERE trim(t.v) <> '')
SELECT id, category FROM tok;

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
100

query I
SELECT count(*) FROM r_re WHERE category = 'cafe';
----
0

# name: test/sql/pullup/join_cluster_passes.test
# description: Stage-4 join-cluster passes: pull-up above joins, semi-reduction, push-below, semi-convert
# group: [aisql]

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE docs AS SELECT range AS id, 'doc '||(range%10)::VARCHAR AS body FROM range(100);
CREATE TABLE qs AS SELECT range AS qid, 'q '||range::VARCHAR AS q FROM range(4);

# multi-table AI join condition is lifted out of the join; under the factor default it becomes
# an AI Factor Join (no cross materialization at all)
query II
EXPLAIN SELECT count(*) FROM docs d, qs q WHERE ai_filter('does '||d.body||' answer '||q.q||'?');
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*

# the pair domain is deduped: 10 distinct bodies x 4 questions = 40 chat calls for 400 pairs
statement ok
SELECT ai_local_cache_clear();
SELECT ai_usage_reset();

query I
SELECT count(*) FROM docs d, qs q WHERE ai_filter('does '||d.body||' answer '||q.q||'?');
----
150

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
40

# result preservation with the whole stack off
statement ok
SET ai_pullup=false; SET ai_factorize='off'; SET ai_semi_reduce=false;
SET ai_reorder=false; SET ai_join_factorize='off';

query I
SELECT count(*) FROM docs d, qs q WHERE ai_filter('does '||d.body||' answer '||q.q||'?');
----
150

statement ok
RESET ai_pullup; RESET ai_factorize; RESET ai_semi_reduce; RESET ai_reorder; RESET ai_join_factorize;

# --- push-below: single-side AI over an equi join lands BELOW the join on the semi-reduced side
statement ok
CREATE TABLE a AS SELECT range AS aid, range % 50 AS k, 'item '||(range%8)::VARCHAR AS x FROM range(200);
CREATE TABLE b AS SELECT range AS bid FROM range(40);

query II
EXPLAIN SELECT a.x, ai_classify(a.x, {'p':'p things','q':'q things'}) FROM a JOIN b ON a.k = b.bid;
----
physical_plan	<REGEX>:(?s).*Join Type: INNER.*Ai Region.*SEMI.*

# push-below preserves results vs off (row-set equality via checksum of sorted output)
query I
SELECT count(*) || '-' || count(DISTINCT x || c) FROM (
  SELECT a.x, ai_classify(a.x, {'p':'p things','q':'q things'}) AS c FROM a JOIN b ON a.k = b.bid);
----
160-8

statement ok
SET ai_join_factorize='off';

query I
SELECT count(*) || '-' || count(DISTINCT x || c) FROM (
  SELECT a.x, ai_classify(a.x, {'p':'p things','q':'q things'}) AS c FROM a JOIN b ON a.k = b.bid);
----
160-8

statement ok
RESET ai_join_factorize;

# --- semi-convert: DISTINCT consumer flips the INNER join to SEMI (no expand at all)
query II
EXPLAIN SELECT DISTINCT ai_classify(a.x, {'p':'p','q':'q'}) FROM a JOIN b ON a.k = b.bid;
----
physical_plan	<REGEX>:(?s).*Ai Region.*Join Type: SEMI.*

query I
SELECT count(*) <= 2 FROM (SELECT DISTINCT ai_classify(a.x, {'p':'p','q':'q'}) FROM a JOIN b ON a.k = b.bid);
----
true

statement ok
CALL ai_mock_stop();

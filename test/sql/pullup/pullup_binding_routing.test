# name: test/sql/pullup/pullup_binding_routing.test
# description: Binding integrity when hoists/pushes reshape plans under positional maps.
# group: [pullup]

#              Bug 1: pullup hoisted filters through a PROJECTION without routing their source
#              columns (dangling base bindings on CTE shapes). Bug 2: the region push-below
#              reordered the child output sequence under a parent FILTER whose positional
#              projection_map then selected the wrong columns. Both found by the PLOP
#              agent_bench CTE workload; both asserted here as no-error + exact result parity
#              against the whole optimizer stack disabled.

require aisql

require parquet

statement ok
CALL ai_mock_start();

# --- Bug 1 shape: AI filter inside a projected CTE (filter columns dropped by the projection),
# pulled above the CTE-join. Pre-fix: INTERNAL Error (Failed to bind column reference).
statement ok
CREATE TABLE t1 AS SELECT 'x'||range::VARCHAR AS a, 'y'||range::VARCHAR AS b FROM range(5);

statement ok
CREATE TABLE u1 AS SELECT range AS k FROM range(3);

statement ok
CREATE TABLE r1 AS
WITH c AS (SELECT upper(a) AS ua FROM t1 WHERE ai_filter('[p=60] p: '||a||' '||b))
SELECT * FROM c, u1;

statement ok
SET ai_pullup=false; SET ai_factorize='off'; SET ai_semi_reduce=false;
SET ai_reorder=false; SET ai_join_factorize='off'; SET ai_limit=false;

statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE r1_off AS
WITH c AS (SELECT upper(a) AS ua FROM t1 WHERE ai_filter('[p=60] p: '||a||' '||b))
SELECT * FROM c, u1;

query I
SELECT count(*) FROM ((SELECT * FROM r1 EXCEPT SELECT * FROM r1_off)
                      UNION ALL (SELECT * FROM r1_off EXCEPT SELECT * FROM r1));
----
0

statement ok
SET ai_pullup=true; SET ai_factorize='all'; SET ai_semi_reduce=true;
SET ai_reorder=true; SET ai_join_factorize='factor'; SET ai_limit=true;

# --- Bug 2 shape: two projected CTEs with COMPUTED join keys, AI filter over many columns the
# projection drops, subset SELECT list + ORDER BY (gives the pulled filter a positional
# projection_map), reviews >> books (region pushed onto the LEFT side, its result column lands
# mid-sequence). Pre-fix: INTERNAL Error at physical planning.
statement ok
CREATE TABLE books AS SELECT 'b_'||range::VARCHAR AS book_id, 'title '||range::VARCHAR AS title,
       'sub '||range::VARCHAR AS subtitle, 'auth '||(range%3)::VARCHAR AS author,
       'cat '||(range%4)::VARCHAR AS categories, 'desc '||range::VARCHAR AS description,
       'feat '||range::VARCHAR AS features, 'det '||range::VARCHAR AS details FROM range(30);

statement ok
CREATE TABLE reviews AS SELECT 'p_'||(range%30)::VARCHAR AS purchase_id,
       TIMESTAMP '2020-06-01' + INTERVAL (range % 300) DAY AS review_time,
       range % 5 AS rating, 'txt '||range::VARCHAR AS text, range % 4 AS helpful_vote,
       range % 2 AS verified_purchase FROM range(200);

statement ok
CREATE TABLE r2 AS
WITH candidates AS (
  SELECT CAST(SPLIT_PART(b.book_id, '_', 2) AS INTEGER) AS book_idx, b.book_id, b.title
  FROM books b
  WHERE b.title IS NOT NULL
    AND ai_filter('[p=60] pick? ' || b.title || ' ' || b.subtitle || ' ' || b.author || ' '
                  || b.categories || ' ' || b.description || ' ' || b.features || ' ' || b.details)
), reviews_filtered AS (
  SELECT CAST(SPLIT_PART(r.purchase_id, '_', 2) AS INTEGER) AS purchase_idx, r.purchase_id,
         r.review_time, CAST(r.rating AS DOUBLE) AS rating, r.text, r.helpful_vote, r.verified_purchase
  FROM reviews r
  WHERE r.verified_purchase = 1 AND CAST(r.rating AS DOUBLE) >= 1 AND r.helpful_vote >= 1
)
SELECT c.book_id, c.title, rf.review_time, rf.rating, rf.helpful_vote, rf.purchase_id, rf.text
FROM candidates c JOIN reviews_filtered rf ON rf.purchase_idx = c.book_idx
ORDER BY rf.review_time DESC;

statement ok
SET ai_pullup=false; SET ai_factorize='off'; SET ai_semi_reduce=false;
SET ai_reorder=false; SET ai_join_factorize='off'; SET ai_limit=false;

statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE r2_off AS
WITH candidates AS (
  SELECT CAST(SPLIT_PART(b.book_id, '_', 2) AS INTEGER) AS book_idx, b.book_id, b.title
  FROM books b
  WHERE b.title IS NOT NULL
    AND ai_filter('[p=60] pick? ' || b.title || ' ' || b.subtitle || ' ' || b.author || ' '
                  || b.categories || ' ' || b.description || ' ' || b.features || ' ' || b.details)
), reviews_filtered AS (
  SELECT CAST(SPLIT_PART(r.purchase_id, '_', 2) AS INTEGER) AS purchase_idx, r.purchase_id,
         r.review_time, CAST(r.rating AS DOUBLE) AS rating, r.text, r.helpful_vote, r.verified_purchase
  FROM reviews r
  WHERE r.verified_purchase = 1 AND CAST(r.rating AS DOUBLE) >= 1 AND r.helpful_vote >= 1
)
SELECT c.book_id, c.title, rf.review_time, rf.rating, rf.helpful_vote, rf.purchase_id, rf.text
FROM candidates c JOIN reviews_filtered rf ON rf.purchase_idx = c.book_idx
ORDER BY rf.review_time DESC;

query I
SELECT count(*) FROM ((SELECT * FROM r2 EXCEPT SELECT * FROM r2_off)
                      UNION ALL (SELECT * FROM r2_off EXCEPT SELECT * FROM r2));
----
0

# --- Bug 3 shape: AI calls NESTED inside non-AI expressions (lower(ai_complete(..)) IN (..)) in
# CTE filters over a multi-join with a subset SELECT list. The region hoist inserts result
# columns mid-sequence under one join side; ancestor FILTER positional maps must be remapped by
# binding identity (RemapPositionalMaps in the region pass) or downstream columns fall off.
# This is the certified repro (agent_bench Q28 on the committed tpch parquet): it fails with the
# remap disabled and runs clean with it.
statement ok
CREATE VIEW IF NOT EXISTS part     AS SELECT * FROM read_parquet('{WORKING_DIRECTORY}/aisql-bench/AGENTBENCH/dataset/tpch/part.parquet');

statement ok
CREATE VIEW IF NOT EXISTS supplier AS SELECT * FROM read_parquet('{WORKING_DIRECTORY}/aisql-bench/AGENTBENCH/dataset/tpch/supplier.parquet');

statement ok
CREATE VIEW IF NOT EXISTS customer AS SELECT * FROM read_parquet('{WORKING_DIRECTORY}/aisql-bench/AGENTBENCH/dataset/tpch/customer.parquet');

statement ok
CREATE VIEW IF NOT EXISTS lineitem AS SELECT * FROM read_parquet('{WORKING_DIRECTORY}/aisql-bench/AGENTBENCH/dataset/tpch/lineitem.parquet');

statement ok
CREATE VIEW IF NOT EXISTS orders   AS SELECT * FROM read_parquet('{WORKING_DIRECTORY}/aisql-bench/AGENTBENCH/dataset/tpch/orders.parquet');

statement ok
CREATE VIEW IF NOT EXISTS partsupp AS SELECT * FROM read_parquet('{WORKING_DIRECTORY}/aisql-bench/AGENTBENCH/dataset/tpch/partsupp.parquet');

statement ok
CREATE VIEW IF NOT EXISTS nation   AS SELECT * FROM read_parquet('{WORKING_DIRECTORY}/aisql-bench/AGENTBENCH/dataset/tpch/nation.parquet');

statement ok
CREATE VIEW IF NOT EXISTS region   AS SELECT * FROM read_parquet('{WORKING_DIRECTORY}/aisql-bench/AGENTBENCH/dataset/tpch/region.parquet');

statement ok
WITH
orders_base AS (
	SELECT
		o.o_orderkey,
		o.o_orderpriority,
		o.o_totalprice,
		o.o_comment,
		o.o_orderdate,
		o.o_custkey
	FROM orders o
	WHERE o.o_orderdate >= DATE '1995-01-01'
		AND o.o_orderdate < DATE '1996-07-01'
		AND o.o_totalprice BETWEEN 100000 AND 220000
		AND o.o_orderstatus = 'O'
		AND o.o_orderpriority IN ('1-URGENT', '2-HIGH')
),
order_focus AS (
	SELECT
		ob.o_orderkey,
		ob.o_orderpriority,
		ob.o_totalprice,
		ob.o_comment,
		ob.o_orderdate,
		ob.o_custkey
	FROM orders_base ob
	WHERE (lower(ai_complete('Does this order look operationally significant based on priority label, total price, and comment content?
Order Priority: ' || ob.o_orderpriority || '
Total Price: ' || ob.o_totalprice || '
Comment: ' || ob.o_comment || '
Return a single YES or NO, with no other words. If uncertain, return YES.' || e'\n Return a single yes or no, do not contain any other words.')) IN ('yes', 'true'))
),
lineitem_filtered AS (
	SELECT
		l.l_orderkey,
		l.l_partkey,
		l.l_suppkey,
		l.l_quantity,
		l.l_extendedprice,
		l.l_discount,
		l.l_shipmode,
		l.l_shipdate
	FROM lineitem l
	WHERE l.l_shipdate >= DATE '1995-01-01'
		AND l.l_shipdate < DATE '1996-07-01'
		AND l.l_quantity BETWEEN 18 AND 26
		AND l.l_discount BETWEEN 0.04 AND 0.07
		AND l.l_shipmode IN ('AIR', 'REG AIR')
),
joined AS (
	SELECT
		of.o_orderkey,
		of.o_orderpriority,
		of.o_totalprice,
		of.o_comment,
		of.o_orderdate,
		of.o_custkey,
		lf.l_partkey,
		lf.l_suppkey,
		lf.l_quantity,
		lf.l_extendedprice,
		lf.l_discount,
		lf.l_shipmode
	FROM order_focus of
	JOIN lineitem_filtered lf
		ON lf.l_orderkey = of.o_orderkey
),
customer_context AS (
	SELECT
		c.c_custkey,
		c.c_name,
		c.c_address,
		c.c_nationkey,
		c.c_phone,
		c.c_acctbal,
		c.c_mktsegment,
		c.c_comment
	FROM customer c
	JOIN (
		SELECT DISTINCT o_custkey
		FROM joined
		LIMIT 60
	) k ON k.o_custkey = c.c_custkey
	WHERE (lower(ai_complete('Does this customer look operationally strategic based on name style, market segment, and account balance?
Customer Name: ' || c.c_name || '
Market Segment: ' || c.c_mktsegment || '
Account Balance: ' || c.c_acctbal || '
Return a single YES or NO, with no other words. If uncertain, return YES.' || e'\n Return a single yes or no, do not contain any other words.')) IN ('yes', 'true'))
)
SELECT *
FROM joined j
JOIN customer_context cc
	ON cc.c_custkey = j.o_custkey
	AND (lower(ai_complete('Could this customer account be strategically important for order fulfillment?
Order Priority: ' || j.o_orderpriority || '
Order Total Price: ' || j.o_totalprice || '
Lineitem Ship Mode: ' || j.l_shipmode || '
Customer Name: ' || cc.c_name || '
Market Segment: ' || cc.c_mktsegment || '
Account Balance: ' || cc.c_acctbal || '
Return a single YES or NO, with no other words. If uncertain, return YES.' || e'\n Return a single yes or no, do not contain any other words.')) IN ('yes', 'true'));

# --- Bug 4 shape (crash): CreatePlan for the extension operators estimated cardinality AFTER
# planning children -- physical planning moves each LogicalGet's bind_data into the physical
# operator, so the estimate recursed into gutted children (nullptr bind_data -> SIGSEGV) whenever
# no earlier optimizer pass had cached the estimate (single-table region shapes skip the join
# cluster passes). Estimate now precedes child planning; this statement simply completing is the
# regression guard.
statement ok
CREATE TABLE biz AS SELECT 'name '||range::VARCHAR AS name, 'desc '||range::VARCHAR AS description,
       range % 30 AS nrev, 'Open '||(range%2)::VARCHAR AS state FROM range(40);

statement ok
CREATE TABLE revs4 AS SELECT range % 40 AS bid, 'review text '||range::VARCHAR AS rtext,
       range % 5 AS stars FROM range(120);

statement ok
WITH picked AS (
  SELECT name, nrev FROM biz
  WHERE nrev >= 3 AND state LIKE 'Open%'
    AND (lower(ai_complete('[p=60] spa? ' || name || ' ' || description)) IN ('yes', 'true'))
), pos AS (
  SELECT p.name, r.rtext FROM picked p JOIN revs4 r ON r.bid = p.nrev WHERE r.stars >= 3
)
SELECT name, count(*) AS n FROM pos GROUP BY name ORDER BY n DESC, name LIMIT 5;

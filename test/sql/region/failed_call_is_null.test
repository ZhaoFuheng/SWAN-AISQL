# name: test/sql/region/failed_call_is_null.test
# description: A call that gets no answer is a NULL verdict on EVERY evaluation path, never a false. The
# group: [region]

#              region's asynchronous dispatcher recorded a failed call as a valid false (Evaluate returned
#              ok && value), so under NOT a failed leaf passed its row: `NOT ai_filter(a) OR ai_filter(b)` kept
#              all 50 rows with every call failed, where NULL OR NULL keeps none. The single-call projection
#              path already produced NULLs. No mock: nothing listens on the endpoint, no retries.

require aisql

statement ok
SET ai_endpoint = 'http://127.0.0.1:1';

statement ok
SET ai_max_retries = 0;

statement ok
CREATE TABLE t AS SELECT 'd' || i AS a, 'e' || i AS b FROM range(50) r(i);

# two leaves, no LIMIT: the asynchronous region path
query I
SELECT count(*) FROM t WHERE NOT ai_filter('x? ' || a) OR ai_filter('y? ' || b);
----
0

# the same tree as a projection: every answer is NULL, none is false
query II
SELECT count(*) FILTER (WHERE v IS NULL), count(*) FILTER (WHERE v = false)
FROM (SELECT (NOT ai_filter('x? ' || a) OR ai_filter('y? ' || b)) AS v FROM t);
----
50	0

# IS NULL on a wrapped leaf stays true for a failed call
query I
SELECT count(*) FROM t WHERE ai_filter('p? ' || a) IS NULL AND ai_filter('q? ' || b) IS NULL;
----
50

# the single-leaf path, for reference
query I
SELECT count(*) FILTER (WHERE v IS NULL) FROM (SELECT ai_filter('x? ' || a) AS v FROM t);
----
50

query I
SELECT sum(failed_calls) > 0 FROM ai_usage();
----
true

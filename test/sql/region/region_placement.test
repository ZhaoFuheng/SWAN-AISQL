# name: test/sql/region/region_placement.test
# description: AI Region placement (ai_factorize), factorized dedup call counts, LIMIT compose
# group: [region]

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE docs AS SELECT 'doc '||(range % 20)::VARCHAR AS d, range AS n FROM range(2000);

# ai_factorize='all' (default): scan-level region wraps the AI call
query II
EXPLAIN SELECT count(*) FROM docs WHERE ai_filter('nice? '||d);
----
physical_plan	<REGEX>:(?s).*Ai Region.*

# the two-currency payoff: 2000 rows, 20 distinct -> exactly 20 calls
statement ok
SELECT ai_local_cache_clear();
SELECT ai_usage_reset();

query I
SELECT count(*) FROM docs WHERE ai_filter('nice? '||d);
----
1300

query I
SELECT sum(llm_calls)::BIGINT FROM ai_usage();
----
20

# result preservation: same rows with regions off (scalar path + local cache dedup)
statement ok
SET ai_factorize = 'off';

query I
SELECT count(*) FROM docs WHERE ai_filter('nice? '||d);
----
1300

# 'filters' mode: no join fan-out here, so no region over a plain scan -- the ai_filter stays
# a bare filter expression (RE2 has no negative lookahead; assert the positive shape instead)
statement ok
SET ai_factorize = 'filters';

query II
EXPLAIN SELECT count(*) FROM docs WHERE ai_filter('nice? '||d);
----
physical_plan	<REGEX>:(?s).*Filter.*ai_filter\(.*Seq Scan.*

statement ok
SET ai_factorize = 'all';

# region + LIMIT compose: exactly k rows, fewer calls than the full distinct domain
statement ok
SELECT ai_local_cache_clear();
SELECT ai_usage_reset();

query I
SELECT count(*) FROM (SELECT d FROM docs WHERE ai_filter('nice? '||d) LIMIT 100);
----
100

# chat calls bounded by the distinct domain (embed calls are the node's MLP features, not LLM work)
query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT <= 20 FROM ai_usage();
----
true

# order preservation through the region (input order kept on the broadcast)
query I
SELECT bool_and(ok) FROM (
  SELECT n = lag(n, 1, n - 1) OVER () + 1 AS ok FROM (
    SELECT n FROM docs WHERE ai_filter('always: '||(n % 1)::VARCHAR) OR true ORDER BY n LIMIT 50));
----
true

# the scalar path (no region) produces identical results
statement ok
SET ai_factorize = 'off';
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM docs WHERE ai_filter('nice? '||d);
----
1300

statement ok
RESET ai_factorize;

statement ok
CALL ai_mock_stop();

# name: test/sql/region/streaming_output.test
# description: Without a LIMIT the region emits rows as they are decided instead of after its whole input is
# group: [region]

#              decided (the sink folds and dispatches; the source hands out the decided prefix, in input
#              order, while verdicts keep landing). A LIMIT the push-down cannot place (above an INNER join,
#              which preserves no side) then stops the pipeline after its first rows, and the calls still
#              queued behind the pool are never made. Results are unchanged: every row still gets its verdict.

require aisql

statement ok
CALL ai_mock_start();

# Two regions of 100 prompts each, every prompt held 200 ms by the mock, under a UNION ALL and a LIMIT 1. The
# push-down does not reach through a UNION (nothing there is row-preserving), so neither region has a
# Limit of its own; the union pulls from the first region, which emits its first decided row after one
# round trip, the limit is met, and the query ends with the rest of the prompts still queued. (A join shape
# would not show this: the semi-join reducer or the join's dynamic filter shrink the AI side first.)
statement ok
CREATE TABLE t AS SELECT i AS id, 'row '||i::VARCHAR AS s FROM range(100) r(i);

statement ok
CREATE TABLE t2 AS SELECT i AS id, 'other '||i::VARCHAR AS s FROM range(100) r(i);

statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

query II
EXPLAIN SELECT s FROM (
  SELECT s FROM t WHERE ai_filter('[p=100][sleep=200] keep '||s)
  UNION ALL
  SELECT s FROM t2 WHERE ai_filter('[p=100][sleep=200] keep '||s)) LIMIT 1;
----
physical_plan	<REGEX>:(?s).*Limit.*Union.*Ai Region.*

query II
EXPLAIN SELECT s FROM (
  SELECT s FROM t WHERE ai_filter('[p=100][sleep=200] keep '||s)
  UNION ALL
  SELECT s FROM t2 WHERE ai_filter('[p=100][sleep=200] keep '||s)) LIMIT 1;
----
physical_plan	<!REGEX>:(?s).*Ai Region.*Limit:.*

query I
SELECT count(*) FROM (
  SELECT s FROM (
    SELECT s FROM t WHERE ai_filter('[p=100][sleep=200] keep '||s)
    UNION ALL
    SELECT s FROM t2 WHERE ai_filter('[p=100][sleep=200] keep '||s)) LIMIT 1);
----
1

# the first row went out while most of the 200 prompts were still queued, and those were never asked
query I
SELECT sum(llm_calls)::BIGINT < 100 FROM ai_usage();
----
true

# --- correctness: streaming changes WHEN rows come out, not WHICH; the full join equals the unfolded plan
statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE v AS SELECT i AS id FROM range(100) r(i);

statement ok
CREATE TABLE streamed AS
  SELECT t.id, t.s FROM t JOIN v ON t.id = v.id WHERE ai_filter('[p=50] keep '||t.s) ORDER BY t.id;

statement ok
SET ai_factorize = 'off';

statement ok
CREATE TABLE plain AS
  SELECT t.id, t.s FROM t JOIN v ON t.id = v.id WHERE ai_filter('[p=50] keep '||t.s) ORDER BY t.id;

statement ok
SET ai_factorize = 'all';

query I
SELECT count(*) FROM (SELECT * FROM streamed EXCEPT SELECT * FROM plain) UNION ALL
SELECT count(*) FROM (SELECT * FROM plain EXCEPT SELECT * FROM streamed);
----
0
0

query I
SELECT count(*) > 0 FROM streamed;
----
true

# --- a NULL verdict (a prompt the model cannot answer) still comes out as NULL per row
statement ok
CREATE TABLE w AS SELECT i AS id, CASE WHEN i % 10 = 0 THEN NULL ELSE 'row '||i::VARCHAR END AS s FROM range(50) r(i);

query I
SELECT count(*) FROM w JOIN v ON w.id = v.id WHERE ai_filter('[p=100] keep '||w.s);
----
45

statement ok
CALL ai_mock_stop();

# name: test/sql/region/wave_overlap.test
# description: Overlapping region waves (ai_debug_wave_overlap) change only SCHEDULING, never results or
#              call counts. A wave's LLM batch is only as wide as the distinct PROMPTS its reps carry, so
#              above a join that repeats one side's prompt across a chunk a wave can issue a single call
#              while Sink blocks on it; running several waves at once refills the request pool. Nothing is
#              speculated, so the work performed must be identical.
#              WHY THE CALL-COUNT ASSERTS ARE SAFE HERE: both shapes below evaluate every distinct prompt
#              (no leaf is ever skipped), so there is no DP-ordering freedom and the count is exact. A
#              shape where short-circuiting makes a leaf unnecessary is NOT count-stable -- the MLP's
#              exploration of that leaf varies with timing in either direction -- so it must not be
#              asserted on. See [[agentbench-latency-wave-trickle]].
# group: [aisql]

require aisql

statement ok
CALL ai_mock_start();

statement ok
SET threads=1;

# 40k rows over 2.5k distinct prompts: ~20 input chunks, so ~20 waves -- enough for overlap to engage.
statement ok
CREATE TABLE fan AS SELECT (range % 2500) AS k FROM range(40000);

statement ok
SET ai_debug_wave_overlap=1;

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE serial_res AS SELECT k FROM fan WHERE ai_filter('[p=50] is '||k::VARCHAR||' ok?');

query I
SELECT (sum(llm_calls)-sum(embed_calls))::BIGINT FROM ai_usage();
----
2500

statement ok
SET ai_debug_wave_overlap=8;

statement ok
SELECT ai_usage_reset();

# ai_local_cache_clear() so the second run pays for its own calls rather than replaying the first's.
statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE overlap_res AS SELECT k FROM fan WHERE ai_filter('[p=50] is '||k::VARCHAR||' ok?');

# exactly the same work: one call per distinct prompt, no more and no fewer
query I
SELECT (sum(llm_calls)-sum(embed_calls))::BIGINT FROM ai_usage();
----
2500

# ... and exactly the same answer
query I
SELECT count(*) FROM ((SELECT * FROM serial_res EXCEPT ALL SELECT * FROM overlap_res)
                      UNION ALL (SELECT * FROM overlap_res EXCEPT ALL SELECT * FROM serial_res));
----
0

# non-vacuous: the predicate really splits the input
query I
SELECT count(*) > 0 AND count(*) < 40000 FROM overlap_res;
----
true

# --- the shape overlap exists for: a cross product that repeats one side's prompt across whole chunks.
# 1000 x 120 = 120,000 reps carrying only 1,120 distinct prompts.
statement ok
CREATE TABLE big AS SELECT (range % 1000) AS a FROM range(1500);

statement ok
CREATE TABLE small AS SELECT range AS b FROM range(120);

statement ok
SET ai_debug_wave_overlap=1;

statement ok
SELECT ai_usage_reset();

statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE xs AS SELECT a, b FROM big CROSS JOIN small
  WHERE ai_filter('[p=20] cust '||b::VARCHAR||'?') AND ai_filter('[p=50] ord '||a::VARCHAR||'?');

query I
SELECT (sum(llm_calls)-sum(embed_calls))::BIGINT FROM ai_usage();
----
1120

statement ok
SET ai_debug_wave_overlap=8;

statement ok
SELECT ai_usage_reset();

statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE xo AS SELECT a, b FROM big CROSS JOIN small
  WHERE ai_filter('[p=20] cust '||b::VARCHAR||'?') AND ai_filter('[p=50] ord '||a::VARCHAR||'?');

query I
SELECT (sum(llm_calls)-sum(embed_calls))::BIGINT FROM ai_usage();
----
1120

query I
SELECT count(*) FROM ((SELECT * FROM xs EXCEPT ALL SELECT * FROM xo)
                      UNION ALL (SELECT * FROM xo EXCEPT ALL SELECT * FROM xs));
----
0

query I
SELECT count(*) > 0 FROM xo;
----
true

# --- failure inside a BACKGROUND wave. The prompt expression is evaluated by the wave's own
# ExpressionExecutor, so error() for one key throws on the worker thread. It must come back as an
# ordinary query error (future::get() rethrows it on the Sink thread), with the other in-flight wave
# joined during teardown rather than left writing into freed buffers. k=2000 lands in the first wave
# (keys 0..2047 fill the first chunk), launched asynchronously while the second is still pending.
statement ok
SET ai_debug_wave_overlap=8;

statement error
SELECT count(*) FROM fan WHERE ai_filter('[p=50] q '||CASE WHEN k = 2000 THEN error('boom-in-wave') ELSE k::VARCHAR END);
----
<REGEX>:.*boom-in-wave.*

# the connection survives the unwind
query I
SELECT count(*) FROM fan;
----
40000

# --- several sink SEGMENTS, waves in flight across them. A UNION ALL feeds the region from two
# pipelines; each gets its own local sink state, map and in-flight list, and Combine must settle a
# segment's background waves before it is handed to the global state. The second segment repeats the
# first's prompts while the first's waves may still be in flight, so this also exercises the in-flight
# registry across concurrently running waves: every distinct prompt is still paid for exactly once.
statement ok
RESET threads;

statement ok
SET ai_debug_wave_overlap=8;

statement ok
SELECT ai_usage_reset();

statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE two_seg AS
SELECT k FROM (SELECT k FROM fan UNION ALL SELECT k FROM fan) u WHERE ai_filter('[p=50] is '||u.k::VARCHAR||' ok?');

# one call per distinct prompt, across both segments
query I
SELECT (sum(llm_calls)-sum(embed_calls))::BIGINT FROM ai_usage();
----
2500

# and each segment produced exactly the serial answer
query I
SELECT count(*) FROM ((SELECT k FROM two_seg EXCEPT ALL (SELECT k FROM serial_res UNION ALL SELECT k FROM serial_res))
                      UNION ALL ((SELECT k FROM serial_res UNION ALL SELECT k FROM serial_res) EXCEPT ALL SELECT k FROM two_seg));
----
0

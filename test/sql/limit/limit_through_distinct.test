# name: test/sql/limit/limit_through_distinct.test
# description: LIMIT k over a plain DISTINCT reaches the AI region as "k distinct passing tuples": the region
# group: [limit]

#              stops once k distinct keys have passed instead of evaluating every distinct input, and the
#              answer is exactly k sound rows. The shape is SWAN 2.0's
#              SELECT DISTINCT name ... WHERE ai_filter(...) AND id IN (subquery) LIMIT k, where the
#              semi-join lift puts the region above the join and the DISTINCT between it and the LIMIT.

require aisql

statement ok
CALL ai_mock_start();

# 400 players, 40 distinct names (10 rows each); the subquery keeps 80% of them -> the region sees 320 rows
# folded to 40 distinct names
statement ok
CREATE TABLE player AS SELECT i AS id, 'player '||(i % 40)::VARCHAR AS name FROM range(400) r(i);

statement ok
CREATE TABLE attr AS SELECT i AS id, (i % 5) AS speed FROM range(400) r(i);

statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

# the plan: the LIMIT is on the region, keyed on the DISTINCT column
query II
EXPLAIN SELECT DISTINCT p.name FROM player p
WHERE p.id IN (SELECT id FROM attr WHERE speed >= 1) AND ai_filter('[p=50] born before 1990? '||p.name)
LIMIT 5;
----
physical_plan	<REGEX>:(?s).*Ai Region.*Limit: 5.*Distinct On: #0.*

# exactly k rows, each a distinct name
query I
SELECT count(*) FROM (
  SELECT DISTINCT p.name FROM player p
  WHERE p.id IN (SELECT id FROM attr WHERE speed >= 1) AND ai_filter('[p=50] born before 1990? '||p.name)
  LIMIT 5);
----
5

# the early stop: strictly fewer calls than the 40 distinct names (one wave of max(k, concurrency) reps
# already holds >= 5 passers at the mock's 50% pass rate)
query I
SELECT sum(llm_calls)::BIGINT < 40 FROM ai_usage();
----
true

statement ok
CREATE TABLE calls_on AS SELECT sum(llm_calls)::BIGINT AS c FROM ai_usage();

# soundness: every returned name passes the filter (re-checked against the full evaluation)
statement ok
CREATE TABLE limited AS
  SELECT DISTINCT p.name FROM player p
  WHERE p.id IN (SELECT id FROM attr WHERE speed >= 1) AND ai_filter('[p=50] born before 1990? '||p.name)
  LIMIT 5;

query I
SELECT count(*) FROM limited l WHERE NOT ai_filter('[p=50] born before 1990? '||l.name);
----
0

query I
SELECT count(DISTINCT name) FROM limited;
----
5

# a DISTINCT whose key is computed from the column is NOT pushed (distinct inputs could merge): the plan
# carries no Distinct On, and the answer is still exactly k
query II
EXPLAIN SELECT DISTINCT length(p.name) % 3 AS k FROM player p
WHERE p.id IN (SELECT id FROM attr WHERE speed >= 1) AND ai_filter('[p=50] born before 1990? '||p.name)
LIMIT 2;
----
physical_plan	<!REGEX>:(?s).*Distinct On.*

query I
SELECT count(*) FROM (
  SELECT DISTINCT length(p.name) % 3 AS k FROM player p
  WHERE p.id IN (SELECT id FROM attr WHERE speed >= 1) AND ai_filter('[p=50] born before 1990? '||p.name)
  LIMIT 2);
----
2

# with the pass off the same query still returns k, and asks more: nothing stops the region's evaluation
# (the speculative leaf below the join decides some rows first, so the count is not simply the 40 names)
statement ok
SET ai_limit = false;

statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FROM (
  SELECT DISTINCT p.name FROM player p
  WHERE p.id IN (SELECT id FROM attr WHERE speed >= 1) AND ai_filter('[p=50] born before 1990? '||p.name)
  LIMIT 5);
----
5

query I
SELECT sum(llm_calls)::BIGINT > (SELECT c FROM calls_on) FROM ai_usage();
----
true

statement ok
SET ai_limit = true;

statement ok
CALL ai_mock_stop();

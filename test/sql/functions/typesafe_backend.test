# name: test/sql/functions/typesafe_backend.test
# description: ai_filter -> TypeSafe Noul and ai_classify -> TypeSafe Choice behind SET ai_typesafe
# group: [aisql]

require aisql

statement ok
CALL ai_mock_start();

# the response cache is process-wide: a second run of this file in one unittest process must refetch
statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE docs AS SELECT 'doc '||range::VARCHAR AS d FROM range(10);

# default: off -> the chat path (same verdicts as ai_functions_mock.test)
query I
SELECT count(*) FROM docs WHERE ai_filter('is ' || d || ' good?');
----
7

query I
SELECT sum(llm_calls)::BIGINT FROM ai_usage();
----
10

# ---- ai_filter -> Noul -------------------------------------------------------------------------
# The mock seeds a Noul exactly like the chat path's boolean schema, so the verdicts agree: same 7
# rows. A System One answer is a DIFFERENT sample from a chat answer, so it is never served from
# the chat entry in the local cache: 10 new calls, not 10 hits.
statement ok
SET ai_typesafe = 'filter';

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FROM docs WHERE ai_filter('is ' || d || ' good?');
----
7

query II
SELECT sum(llm_calls)::BIGINT, sum(cache_hits)::BIGINT FROM ai_usage();
----
10	0

# priced per input token (mock: 8 tokens/call at $0.042/Mtok), never zero
query I
SELECT sum(cost_usd) > 0 FROM ai_usage();
----
true

# the threshold turns the probability into the verdict: mock yes = 0.9, so 0.95 fails everything
statement ok
SET ai_typesafe_threshold = 0.95;

statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) FROM docs WHERE ai_filter('is ' || d || ' good?');
----
0

statement ok
SET ai_typesafe_threshold = 0.5;

statement error
SET ai_typesafe_threshold = 1.5;
----
<REGEX>:.*ai_typesafe_threshold must be in.*

# Jev is text-only: an image-bearing prompt stays on the chat model even with the route on
statement ok
SELECT ai_local_cache_clear();

query I
SELECT count(*) >= 0 FROM docs WHERE ai_filter('is ' || d || ' good? ' || ai_image('http://example.invalid/' || d || '.png'));
----
true

# ---- ai_classify -> Choice ---------------------------------------------------------------------
statement ok
SET ai_typesafe = 'classify';

statement ok
SELECT ai_usage_reset();

# list categories: the answer is always one of the listed options
query I
SELECT count(*) FILTER (WHERE c IN ('alpha', 'beta', 'gamma')) FROM (SELECT ai_classify(d, ['alpha', 'beta', 'gamma']) AS c FROM docs);
----
10

# struct categories: labels are the field names (descriptions ride as Choice criteria)
query I
SELECT count(*) FILTER (WHERE c IN ('pos', 'neg')) FROM (SELECT ai_classify(d, {'pos': 'a positive text', 'neg': 'a negative text'}) AS c FROM docs);
----
10

query I
SELECT sum(llm_calls)::BIGINT FROM ai_usage();
----
20

# the reorder node's classify LEAF asks the same Choice as the scalar: reorder on/off agree
statement ok
CREATE TABLE cls AS SELECT d, ai_classify(d, ['alpha', 'beta', 'gamma']) AS c FROM docs;

statement ok
SET ai_reorder = false;

query I
SELECT count(*) FROM docs WHERE ai_classify(d, ['alpha', 'beta', 'gamma']) = 'alpha' AND ai_filter('is ' || d || ' good?');
----
<REGEX>:[0-9]+

statement ok
SET ai_reorder = true;

query I
SELECT (SELECT count(*) FROM docs WHERE ai_classify(d, ['alpha', 'beta', 'gamma']) = 'alpha' AND ai_filter('is ' || d || ' good?'))
     = (SELECT count(*) FROM cls WHERE c = 'alpha' AND ai_filter('is ' || d || ' good?'));
----
true

# both functions routed at once
statement ok
SET ai_typesafe = 'filter,classify';

statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FROM docs WHERE ai_filter('is ' || d || ' good?') AND ai_classify(d, ['alpha', 'beta']) IN ('alpha', 'beta');
----
7

# off again: back to the chat path, its cached entries still valid
statement ok
SET ai_typesafe = '';

# ---- ai_score -> Score --------------------------------------------------------------------------
statement ok
SET ai_typesafe = 'score';

statement ok
SELECT ai_usage_reset();

# integer bounds spanning <= 10 values -> a Score over the levels; the expected level maps back onto
# [lo, hi] and rounds to the BIGINT scale, so every answer is a valid score and none is NULL
query II
SELECT count(*) FILTER (WHERE s BETWEEN 1 AND 5), count(*) FILTER (WHERE s IS NULL)
FROM (SELECT ai_score(d, 'how good is it?\n1: terrible\n2: bad\n3: fine\n4: good\n5: great', 1, 5) AS s FROM docs);
----
10	0

query I
SELECT sum(llm_calls)::BIGINT FROM ai_usage();
----
10

# the reorder node's score LEAF asks the same Score as the scalar: reorder on/off agree
statement ok
CREATE TABLE sc AS SELECT d, ai_score(d, 'how good is it?', 1, 5) AS s FROM docs;

statement ok
SET ai_reorder = false;

query I
SELECT (SELECT count(*) FROM docs WHERE ai_score(d, 'how good is it?', 1, 5) >= 3 AND ai_filter('is ' || d || ' good?'))
     = (SELECT count(*) FROM sc WHERE s >= 3 AND ai_filter('is ' || d || ' good?'));
----
true

statement ok
SET ai_reorder = true;

query I
SELECT (SELECT count(*) FROM docs WHERE ai_score(d, 'how good is it?', 1, 5) >= 3 AND ai_filter('is ' || d || ' good?'))
     = (SELECT count(*) FROM sc WHERE s >= 3 AND ai_filter('is ' || d || ' good?'));
----
true

# forms that do not fit a Score stay on the chat model and still answer: double bounds, no bounds,
# more than 10 levels
query I
SELECT count(*) FILTER (WHERE s IS NOT NULL)
FROM (SELECT ai_score(d, 'how good is it?', 0.0, 1.0) AS s FROM docs
      UNION ALL SELECT ai_score(d, 'how good is it?') FROM docs
      UNION ALL SELECT ai_score(d, 'how good is it?', 1, 100) FROM docs);
----
30

statement ok
SET ai_typesafe = '';

statement ok
CALL ai_mock_stop();

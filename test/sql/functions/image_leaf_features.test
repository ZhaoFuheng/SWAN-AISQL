# name: test/sql/functions/image_leaf_features.test
# description: An image leaf gets a real selectivity feature (predicate text x image through the
#              dual-encoder embeddings route) instead of the neutral prior, on both evaluation
#              paths (per-row batch and the leaf region). ai_embed_images=false restores the
#              neutral prior: the answer is identical (a conjunction is order-independent) and
#              the image leaf costs no embed request.
# group: [aisql]

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE products AS SELECT range AS id, 'product number ' || range::VARCHAR || ' description' AS txt,
    'http://example.invalid/img' || range::VARCHAR || '.png' AS img FROM range(300);

# --- image leaf embedded (default) ------------------------------------------------------------------
statement ok
SELECT ai_usage_reset();

# the embed cache is process-wide: a second run of this file in one unittest process must refetch
statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE r_on AS SELECT id FROM products
  WHERE ai_filter('[p=50] is this a dress? ' || ai_image(img)) AND ai_filter('[p=50] is the text about clothing? ' || txt);

statement ok
CREATE TABLE u_on AS SELECT sum(embed_calls)::BIGINT AS embeds, (sum(llm_calls) - sum(embed_calls))::BIGINT AS calls FROM ai_usage();

# --- image leaf neutral (ai_embed_images = false) ---------------------------------------------------
statement ok
SET ai_embed_images = false;

statement ok
SELECT ai_usage_reset();

statement ok
SELECT ai_local_cache_clear();

statement ok
CREATE TABLE r_off AS SELECT id FROM products
  WHERE ai_filter('[p=50] is this a dress? ' || ai_image(img)) AND ai_filter('[p=50] is the text about clothing? ' || txt);

statement ok
CREATE TABLE u_off AS SELECT sum(embed_calls)::BIGINT AS embeds, (sum(llm_calls) - sum(embed_calls))::BIGINT AS calls FROM ai_usage();

statement ok
SET ai_embed_images = true;

# same rows either way
query I
SELECT count(*) FROM (SELECT id FROM r_on EXCEPT SELECT id FROM r_off) UNION ALL SELECT count(*) FROM (SELECT id FROM r_off EXCEPT SELECT id FROM r_on);
----
0
0

# the image leaf was embedded only when enabled; both runs answered with LLM calls
query I
SELECT (SELECT embeds FROM u_on) > (SELECT embeds FROM u_off) AND (SELECT calls FROM u_on) > 0 AND (SELECT calls FROM u_off) > 0;
----
true

statement ok
CALL ai_mock_stop();

# name: test/sql/functions/hedge_lifetime.test
# description: A hedge's losing attempt runs on its own thread after the batch has returned its winner, so it
# group: [functions]

#              must own everything it touches: the configuration (a connection's stack copy once any ai_*
#              setting is set on the connection) and turbo mode's limiter. Here every prompt sleeps 400 ms
#              under a 100 ms hedge deadline (the 'hedge=NNN' debug knob), so every call hedges and every
#              loser finishes after its batch is gone; the queries after it must still run.

require aisql

statement ok
CALL ai_mock_start();

# any connection-scoped setting makes the batch run on a stack copy of the configuration
statement ok
SET ai_concurrency = 4;

statement ok
SET ai_hedge = true;

statement ok
SET ai_debug_log = 'hedge=100';

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FROM range(12) r(i) WHERE ai_filter('[sleep=400][p=100] item ' || i::VARCHAR || ' is fine?');
----
12

# every call hedged (its first attempt was still asleep at the deadline)
query I
SELECT (SELECT sum(hedged_calls) FROM ai_usage()) >= 12;
----
true

# the losers land while these run; nothing to crash into
query I
SELECT count(*) FROM range(12) r(i) WHERE ai_filter('[sleep=400][p=100] item ' || i::VARCHAR || ' is still fine?');
----
12

query I
SELECT count(*) FROM range(5) r(i) WHERE ai_filter('[p=100] quick ' || i::VARCHAR);
----
5

statement ok
SET ai_hedge = false;

statement ok
CALL ai_mock_stop();

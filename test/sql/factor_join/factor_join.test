# name: test/sql/factor_join/factor_join.test
# description: Factorized semantic join: pair-domain calls, no cross materialization, exact parity
# group: [aisql]

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE docs AS SELECT range AS id, 'doc '||(range%10)::VARCHAR AS body FROM range(100);
CREATE TABLE qs AS SELECT range AS qid, 'q '||range::VARCHAR AS q FROM range(4);

# default (ai_join_factorize='factor'): the pulled-up AI join condition becomes an AI Factor Join
query II
EXPLAIN SELECT count(*) FROM docs d, qs q WHERE ai_filter('does '||d.body||' answer '||q.q||'?');
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*

# calls = the distinct pair domain (10 bodies x 4 questions), never the 400 joined rows
statement ok
SELECT ai_local_cache_clear();
SELECT ai_usage_reset();

query I
SELECT count(*) FROM docs d, qs q WHERE ai_filter('does '||d.body||' answer '||q.q||'?');
----
150

query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT FROM ai_usage();
----
40

# exact multiset parity with the region path
statement ok
CREATE TABLE f AS SELECT id, qid FROM docs d, qs q WHERE ai_filter('does '||d.body||' answer '||q.q||'?');

statement ok
SET ai_join_factorize = 'pushdown';

query II
EXPLAIN SELECT count(*) FROM docs d, qs q WHERE ai_filter('does '||d.body||' answer '||q.q||'?');
----
physical_plan	<REGEX>:(?s).*Ai Region.*Cross Product.*

statement ok
CREATE TABLE o AS SELECT id, qid FROM docs d, qs q WHERE ai_filter('does '||d.body||' answer '||q.q||'?');

query II
SELECT (SELECT count(*) FROM (SELECT * FROM f EXCEPT ALL SELECT * FROM o)),
       (SELECT count(*) FROM (SELECT * FROM o EXCEPT ALL SELECT * FROM f));
----
0	0

statement ok
SET ai_join_factorize = 'factor';

# duplicate-heavy build side: multiplicities expand correctly (each passing pair emits count copies)
statement ok
CREATE TABLE l2 AS SELECT 'x'||(range%3)::VARCHAR AS a FROM range(9);
CREATE TABLE r2 AS SELECT 'y'||(range%2)::VARCHAR AS b FROM range(10);

statement ok
SELECT ai_local_cache_clear();
SELECT ai_usage_reset();

# 3 x 2 = 6 distinct pairs evaluated; output rows = passing pairs x (3 dup left) x (5 dup right)
query I
SELECT (sum(llm_calls) - sum(embed_calls))::BIGINT <= 6 FROM (
  SELECT count(*) FROM l2, r2 WHERE ai_filter('pair '||a||' '||b||'?')), ai_usage();
----
true

query I
SELECT count(*) % 15 FROM l2, r2 WHERE ai_filter('pair '||a||' '||b||'?');
----
0

statement ok
CALL ai_mock_stop();

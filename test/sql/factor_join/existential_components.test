# name: test/sql/factor_join/existential_components.test
# description: An existentially consumed factor graph whose edges form two components evaluates both
# group: [factor_join]

#              (usefulness used to flow only from the existential side's component, so the other
#              component's pairs were never asked and EXISTS was false for every row)

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE ta AS SELECT 'a' || i AS x FROM range(3) r(i);

statement ok
CREATE TABLE tb AS SELECT 'b' || i AS y FROM range(2) r(i);

statement ok
CREATE TABLE tc AS SELECT 'c' || i AS z FROM range(2) r(i);

statement ok
CREATE TABLE td AS SELECT 'd' || i AS w FROM range(2) r(i);

# two components: ta-tb and tc-td
query I
SELECT count(*) FROM ta WHERE EXISTS (SELECT 1 FROM tb, tc, td
  WHERE ai_filter('[p=100] eab? ' || ta.x || ' ' || tb.y) AND ai_filter('[p=100] ecd? ' || tc.z || ' ' || td.w));
----
3

# the other component decides too: no cd pair passes, so nothing exists
query I
SELECT count(*) FROM ta WHERE EXISTS (SELECT 1 FROM tb, tc, td
  WHERE ai_filter('[p=100] eab2? ' || ta.x || ' ' || tb.y) AND ai_filter('[p=0] ecd2? ' || tc.z || ' ' || td.w));
----
0

# a unary-only side is its own component as well
query I
SELECT count(*) FROM ta WHERE EXISTS (SELECT 1 FROM tb, tc
  WHERE ai_filter('[p=100] eab3? ' || ta.x || ' ' || tb.y) AND ai_filter('[p=100] ec3? ' || tc.z));
----
3

# a disconnected component is independent of every member: one confirmed tuple in it settles the existential
# for all of them, so its remaining pairs are not asked (100 cd pairs all pass; well under 100 calls in total)
statement ok
CREATE TABLE tc10 AS SELECT 'c' || i AS z FROM range(10) r(i);

statement ok
CREATE TABLE td10 AS SELECT 'd' || i AS w FROM range(10) r(i);

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FROM ta WHERE EXISTS (SELECT 1 FROM tb, tc10, td10
  WHERE ai_filter('[p=100] eab4? ' || ta.x || ' ' || tb.y) AND ai_filter('[p=100] ecd4? ' || tc10.z || ' ' || td10.w));
----
3

query I
SELECT sum(llm_calls) < 60 FROM ai_usage();
----
true

# the un-factorized plan agrees on a mixed instance
statement ok
CREATE TABLE exist_graph AS SELECT * FROM ta WHERE EXISTS (SELECT 1 FROM tb, tc, td
  WHERE ai_filter('mixed ab? ' || ta.x || ' ' || tb.y) AND ai_filter('mixed cd? ' || tc.z || ' ' || td.w));

statement ok
SET ai_join_factorize = 'off';

statement ok
CREATE TABLE exist_off AS SELECT * FROM ta WHERE EXISTS (SELECT 1 FROM tb, tc, td
  WHERE ai_filter('mixed ab? ' || ta.x || ' ' || tb.y) AND ai_filter('mixed cd? ' || tc.z || ' ' || td.w));

statement ok
SET ai_join_factorize = 'factor';

query I
SELECT count(*) FROM (
  (SELECT * FROM exist_graph EXCEPT SELECT * FROM exist_off)
  UNION ALL
  (SELECT * FROM exist_off EXCEPT SELECT * FROM exist_graph));
----
0

statement ok
CALL ai_mock_stop();

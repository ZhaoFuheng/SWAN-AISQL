# name: test/sql/factor_join/pair_domain_limit.test
# description: The factor graph holds one byte per (left, right) pair of an edge before pruning, so a join
# group: [factor_join]

#              of two large sides would allocate their whole pair domain (100k x 100k = 10 GB). Above
#              ai_factor_pair_limit estimated pairs the rewrite steps aside and the region over the cross
#              product evaluates the join, streaming the pairs. The result is the same either way.

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE ta AS SELECT 'a' || i::VARCHAR AS x FROM range(40) r(i);

statement ok
CREATE TABLE tb AS SELECT 'b' || i::VARCHAR AS y FROM range(30) r(i);

# 1,200 pairs: under the default limit the graph is built
query II
EXPLAIN SELECT * FROM ta, tb WHERE ai_filter('[p=30] edge ok? ' || x || ' ' || y);
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*

statement ok
CREATE TABLE with_graph AS SELECT * FROM ta, tb WHERE ai_filter('[p=30] edge ok? ' || x || ' ' || y);

# a limit below the pair domain: no graph, the region over the cross product instead
statement ok
SET ai_factor_pair_limit = 1000;

query II
EXPLAIN SELECT * FROM ta, tb WHERE ai_filter('[p=30] edge ok? ' || x || ' ' || y);
----
physical_plan	<!REGEX>:(?s).*Ai Factor Graph.*

query II
EXPLAIN SELECT * FROM ta, tb WHERE ai_filter('[p=30] edge ok? ' || x || ' ' || y);
----
physical_plan	<REGEX>:(?s).*Ai Region.*

statement ok
CREATE TABLE without_graph AS SELECT * FROM ta, tb WHERE ai_filter('[p=30] edge ok? ' || x || ' ' || y);

query I
SELECT count(*) FROM (SELECT * FROM with_graph EXCEPT SELECT * FROM without_graph) UNION ALL
SELECT count(*) FROM (SELECT * FROM without_graph EXCEPT SELECT * FROM with_graph);
----
0
0

query I
SELECT count(*) > 0 FROM with_graph;
----
true

# at the limit itself the graph is still taken
statement ok
SET ai_factor_pair_limit = 1200;

query II
EXPLAIN SELECT * FROM ta, tb WHERE ai_filter('[p=30] edge ok? ' || x || ' ' || y);
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*

statement ok
CALL ai_mock_stop();

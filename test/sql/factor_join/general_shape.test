# name: test/sql/factor_join/general_shape.test
# description: Any Boolean shape over one- and two-side leaves runs factorized. A predicate that is not a
# group: [factor_join]

#              conjunction of factors is taken as the terms of its disjunctive normal form, each term a
#              conjunctive factor graph over the same member dictionaries, results united; a later term skips
#              the members and pairs an earlier term already proved for every tuple through them. Rows equal
#              the un-factorized plan's; calls stay per member and per pair.

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE ta AS SELECT 'a' || i::VARCHAR AS x FROM range(30) r(i);

statement ok
CREATE TABLE tb AS SELECT 'b' || i::VARCHAR AS y FROM range(20) r(i);

statement ok
CREATE TABLE tc AS SELECT 'c' || i::VARCHAR AS z FROM range(12) r(i);

# --- OR across sides: a side leaf on c, an edge on (a, b): two terms
query II
EXPLAIN SELECT * FROM ta, tb, tc WHERE ai_filter('[p=30] uc ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y);
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*Terms: 2.*Factors: L0 \| L1.*

statement ok
CREATE TABLE g1 AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=30] uc ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y);

# --- OR across two edges of a chain
statement ok
CREATE TABLE g2 AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=20] eab ' || x || ' ' || y) OR ai_filter('[p=20] ebc ' || y || ' ' || z);

# --- NOT over a conjunction that spans three sides (De Morgan: an OR of negated leaves)
statement ok
CREATE TABLE g3 AS SELECT x, y, z FROM ta, tb, tc WHERE NOT (ai_filter('[p=60] eab ' || x || ' ' || y) AND ai_filter('[p=60] uc ' || z));

# --- OR of three side leaves on three sides: three one-sided terms, no edge at all
query II
EXPLAIN SELECT * FROM ta, tb, tc WHERE ai_filter('[p=30] ua ' || x) OR ai_filter('[p=30] ub ' || y) OR ai_filter('[p=30] uc ' || z);
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*Terms: 3.*

statement ok
CREATE TABLE g4 AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=30] ua ' || x) OR ai_filter('[p=30] ub ' || y) OR ai_filter('[p=30] uc ' || z);

# --- a mixed tree: (edge AND side) OR (other edge of the chain)
statement ok
CREATE TABLE g5 AS SELECT x, y, z FROM ta, tb, tc WHERE (ai_filter('[p=30] eab ' || x || ' ' || y) AND ai_filter('[p=50] ua ' || x)) OR ai_filter('[p=20] ebc ' || y || ' ' || z);

# --- the same without the graph
statement ok
SET ai_join_factorize = 'off';

statement ok
CREATE TABLE r1 AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=30] uc ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y);

statement ok
CREATE TABLE r2 AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=20] eab ' || x || ' ' || y) OR ai_filter('[p=20] ebc ' || y || ' ' || z);

statement ok
CREATE TABLE r3 AS SELECT x, y, z FROM ta, tb, tc WHERE NOT (ai_filter('[p=60] eab ' || x || ' ' || y) AND ai_filter('[p=60] uc ' || z));

statement ok
CREATE TABLE r4 AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=30] ua ' || x) OR ai_filter('[p=30] ub ' || y) OR ai_filter('[p=30] uc ' || z);

statement ok
CREATE TABLE r5 AS SELECT x, y, z FROM ta, tb, tc WHERE (ai_filter('[p=30] eab ' || x || ' ' || y) AND ai_filter('[p=50] ua ' || x)) OR ai_filter('[p=20] ebc ' || y || ' ' || z);

statement ok
SET ai_join_factorize = 'factor';

query IIIII
SELECT (SELECT count(*) FROM g1) > 0, (SELECT count(*) FROM g2) > 0, (SELECT count(*) FROM g3) > 0, (SELECT count(*) FROM g4) > 0, (SELECT count(*) FROM g5) > 0;
----
true	true	true	true	true

query IIIII
SELECT (SELECT count(*) FROM ((SELECT * FROM g1 EXCEPT SELECT * FROM r1) UNION ALL (SELECT * FROM r1 EXCEPT SELECT * FROM g1))),
       (SELECT count(*) FROM ((SELECT * FROM g2 EXCEPT SELECT * FROM r2) UNION ALL (SELECT * FROM r2 EXCEPT SELECT * FROM g2))),
       (SELECT count(*) FROM ((SELECT * FROM g3 EXCEPT SELECT * FROM r3) UNION ALL (SELECT * FROM r3 EXCEPT SELECT * FROM g3))),
       (SELECT count(*) FROM ((SELECT * FROM g4 EXCEPT SELECT * FROM r4) UNION ALL (SELECT * FROM r4 EXCEPT SELECT * FROM g4))),
       (SELECT count(*) FROM ((SELECT * FROM g5 EXCEPT SELECT * FROM r5) UNION ALL (SELECT * FROM r5 EXCEPT SELECT * FROM g5)));
----
0	0	0	0	0

query IIIII
SELECT (SELECT count(*) FROM g1) = (SELECT count(*) FROM r1), (SELECT count(*) FROM g2) = (SELECT count(*) FROM r2), (SELECT count(*) FROM g3) = (SELECT count(*) FROM r3), (SELECT count(*) FROM g4) = (SELECT count(*) FROM r4), (SELECT count(*) FROM g5) = (SELECT count(*) FROM r5);
----
true	true	true	true	true

# --- coverage: the side-only term runs first, and when it proves every tuple the edge term asks nothing
statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

query I
SELECT count(*) FROM ta, tb, tc WHERE ai_filter('[p=100] uc-all ' || z) OR ai_filter('[p=20] eab-never ' || x || ' ' || y);
----
7200

query I
SELECT sum(llm_calls + cache_hits) FROM ai_usage();
----
12

# --- a side-only first term that proves half the c's: the edge term still asks every pair once
statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE g6 AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=50] uc-half ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y);

query I
SELECT sum(llm_calls + cache_hits) <= 12 + 600 FROM ai_usage();
----
true

# --- NULL inside a term: a failed side leaf passes nothing of its term; the other term still decides
query II
SELECT (SELECT count(*) FROM ta, tb, tc WHERE ai_filter('[fail] uc ' || z) OR ai_filter('[p=100] eab ' || x || ' ' || y)),
       (SELECT count(*) FROM ta, tb, tc WHERE ai_filter('[fail] uc ' || z) OR ai_filter('[p=0] eab ' || x || ' ' || y));
----
7200	0

# --- LIMIT and EXISTS over a two-term shape
query I
SELECT count(*) FROM (SELECT * FROM ta, tb, tc WHERE ai_filter('[p=30] uc ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y) LIMIT 7);
----
7

statement ok
CREATE TABLE ex_graph AS SELECT x FROM ta WHERE EXISTS (SELECT 1 FROM tb, tc WHERE ai_filter('[p=5] uc ' || z) OR ai_filter('[p=5] eab ' || ta.x || ' ' || y));

statement ok
SET ai_join_factorize = 'off';

statement ok
CREATE TABLE ex_off AS SELECT x FROM ta WHERE EXISTS (SELECT 1 FROM tb, tc WHERE ai_filter('[p=5] uc ' || z) OR ai_filter('[p=5] eab ' || ta.x || ' ' || y));

statement ok
SET ai_join_factorize = 'factor';

query I
SELECT count(*) FROM ((SELECT * FROM ex_graph EXCEPT SELECT * FROM ex_off) UNION ALL (SELECT * FROM ex_off EXCEPT SELECT * FROM ex_graph));
----
0

# --- the dense scheduler on the two-term shape
statement ok
SET ai_factor_state = 'dense';

statement ok
CREATE TABLE d1 AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=30] uc ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y);

statement ok
SET ai_factor_state = 'sparse';

query I
SELECT count(*) FROM ((SELECT * FROM d1 EXCEPT SELECT * FROM g1) UNION ALL (SELECT * FROM g1 EXCEPT SELECT * FROM d1));
----
0

# --- pair coverage on an edge two terms share: term 1 (e, ua) proves every tuple of the pairs whose a passed ua,
#     term 2 (e2, wc) asks e2 only on the other pairs, and never re-asks a proved pair (no cache hit either)
statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE g7 AS SELECT x, y, z FROM ta, tb, tc WHERE (ai_filter('[p=100] e-all ' || x || ' ' || y) AND ai_filter('[p=50] ua-half ' || x)) OR (ai_filter('[p=100] e2-all ' || x || ' ' || y) AND ai_filter('[p=50] wc-half ' || z));

query I
SELECT sum(llm_calls + cache_hits) FROM ai_usage();
----
642

# --- count products with terms (duplicates on a side)
statement ok
CREATE TABLE tad AS SELECT x FROM ta UNION ALL SELECT x FROM ta WHERE x LIKE 'a1%';

statement ok
CREATE TABLE g9 AS SELECT x, y, z FROM tad, tb, tc WHERE ai_filter('[p=30] uc ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y);

# --- a LIMIT that the first term alone cannot fill: the union keeps growing through the later term
query I
SELECT count(*) FROM (SELECT * FROM ta, tb, tc WHERE ai_filter('[p=5] uc-rare ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y) LIMIT 1000);
----
1000

# --- the dense scheduler with seeded pairs (the same shape as g7)
statement ok
SET ai_factor_state = 'dense';

statement ok
CREATE TABLE d7 AS SELECT x, y, z FROM ta, tb, tc WHERE (ai_filter('[p=100] e-all ' || x || ' ' || y) AND ai_filter('[p=50] ua-half ' || x)) OR (ai_filter('[p=100] e2-all ' || x || ' ' || y) AND ai_filter('[p=50] wc-half ' || z));

statement ok
SET ai_factor_state = 'sparse';

# --- all of the above without the graph
statement ok
SET ai_join_factorize = 'off';

statement ok
CREATE TABLE r7 AS SELECT x, y, z FROM ta, tb, tc WHERE (ai_filter('[p=100] e-all ' || x || ' ' || y) AND ai_filter('[p=50] ua-half ' || x)) OR (ai_filter('[p=100] e2-all ' || x || ' ' || y) AND ai_filter('[p=50] wc-half ' || z));

statement ok
CREATE TABLE r9 AS SELECT x, y, z FROM tad, tb, tc WHERE ai_filter('[p=30] uc ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y);

statement ok
SET ai_join_factorize = 'factor';

query III
SELECT (SELECT count(*) FROM ((SELECT * FROM g7 EXCEPT SELECT * FROM r7) UNION ALL (SELECT * FROM r7 EXCEPT SELECT * FROM g7))),
       (SELECT count(*) FROM g9) = (SELECT count(*) FROM r9) AND (SELECT count(*) FROM ((SELECT * FROM g9 EXCEPT SELECT * FROM r9) UNION ALL (SELECT * FROM r9 EXCEPT SELECT * FROM g9))) = 0,
       (SELECT count(*) FROM ((SELECT * FROM d7 EXCEPT SELECT * FROM r7) UNION ALL (SELECT * FROM r7 EXCEPT SELECT * FROM d7)));
----
0	true	0

query II
SELECT (SELECT count(*) FROM g7) > 0, (SELECT count(*) FROM g9) > (SELECT count(*) FROM (SELECT DISTINCT * FROM g9));
----
true	true

# --- the term cap: with one term allowed, a two-term shape stays a region
statement ok
SET ai_factor_max_terms = 1;

query II
EXPLAIN SELECT * FROM ta, tb, tc WHERE ai_filter('[p=30] uc ' || z) OR ai_filter('[p=20] eab ' || x || ' ' || y);
----
physical_plan	<!REGEX>:(?s).*Ai Factor Graph.*

statement ok
SET ai_factor_max_terms = 16;

statement ok
CALL ai_mock_stop();

# name: test/sql/factor_join/nested_conjunction.test
# description: DuckDB pushes each AI conjunct to the lowest cross product that has its columns; when two leaves
# group: [factor_join]

#              stay at the top and a third is lifted from below, the pull-up folds a NESTED conjunction
#              (`A(A(L0,L1),L2)`). The factor-graph rewrite and the operator accept any tree of ANDs and
#              leaves, so these joins take the graph: a forest (the sparse scheduler) and a triangle (the
#              staged schedule). Results equal the un-factorized plan's.

require aisql

statement ok
CALL ai_mock_start();

statement ok
CREATE TABLE ta AS SELECT 'a' || i::VARCHAR AS x FROM range(40) r(i);

statement ok
CREATE TABLE tb AS SELECT 'b' || i::VARCHAR AS y FROM range(30) r(i);

statement ok
CREATE TABLE tc AS SELECT 'c' || i::VARCHAR AS z FROM range(20) r(i);

statement ok
CREATE TABLE td AS SELECT 'd' || i::VARCHAR AS w FROM range(10) r(i);

# --- a forest whose fold nests: a-d and c-d stay at the top (both need d), a-b is lifted from (a x b)
query II
EXPLAIN SELECT * FROM ta, tb, tc, td WHERE ai_filter('[p=40] ad? ' || x || ' ' || w) AND ai_filter('[p=40] cd? ' || z || ' ' || w) AND ai_filter('[p=30] ab? ' || x || ' ' || y);
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*

statement ok
CREATE TABLE forest_graph AS SELECT x, y, z, w FROM ta, tb, tc, td WHERE ai_filter('[p=40] ad? ' || x || ' ' || w) AND ai_filter('[p=40] cd? ' || z || ' ' || w) AND ai_filter('[p=30] ab? ' || x || ' ' || y);

# --- the triangle: a cyclic edge graph, evaluated by the staged schedule
query II
EXPLAIN SELECT * FROM ta, tb, tc WHERE ai_filter('[p=30] ab? ' || x || ' ' || y) AND ai_filter('[p=30] bc? ' || y || ' ' || z) AND ai_filter('[p=30] ac? ' || x || ' ' || z);
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*

statement ok
CREATE TABLE tri_graph AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=30] ab? ' || x || ' ' || y) AND ai_filter('[p=30] bc? ' || y || ' ' || z) AND ai_filter('[p=30] ac? ' || x || ' ' || z);

# --- a lifted UNARY leaf under two top edges (a-c, b-c): the fold nests too; c is the root
query II
EXPLAIN SELECT * FROM ta, tb, tc WHERE ai_filter('[p=50] ua? ' || x) AND ai_filter('[p=40] ac? ' || x || ' ' || z) AND ai_filter('[p=40] bc? ' || y || ' ' || z);
----
physical_plan	<REGEX>:(?s).*Ai Factor Graph.*

statement ok
CREATE TABLE unary_graph AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=50] ua? ' || x) AND ai_filter('[p=40] ac? ' || x || ' ' || z) AND ai_filter('[p=40] bc? ' || y || ' ' || z);

# --- the same joins without the graph
statement ok
SET ai_join_factorize = 'off';

statement ok
CREATE TABLE unary_off AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=50] ua? ' || x) AND ai_filter('[p=40] ac? ' || x || ' ' || z) AND ai_filter('[p=40] bc? ' || y || ' ' || z);

query II
EXPLAIN SELECT * FROM ta, tb, tc WHERE ai_filter('[p=30] ab? ' || x || ' ' || y) AND ai_filter('[p=30] bc? ' || y || ' ' || z) AND ai_filter('[p=30] ac? ' || x || ' ' || z);
----
physical_plan	<!REGEX>:(?s).*Ai Factor Graph.*

statement ok
CREATE TABLE forest_off AS SELECT x, y, z, w FROM ta, tb, tc, td WHERE ai_filter('[p=40] ad? ' || x || ' ' || w) AND ai_filter('[p=40] cd? ' || z || ' ' || w) AND ai_filter('[p=30] ab? ' || x || ' ' || y);

statement ok
CREATE TABLE tri_off AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=30] ab? ' || x || ' ' || y) AND ai_filter('[p=30] bc? ' || y || ' ' || z) AND ai_filter('[p=30] ac? ' || x || ' ' || z);

statement ok
SET ai_join_factorize = 'factor';

query II
SELECT (SELECT count(*) FROM forest_graph) > 0, (SELECT count(*) FROM tri_graph) > 0;
----
true	true

query I
SELECT count(*) FROM ((SELECT * FROM forest_graph EXCEPT SELECT * FROM forest_off) UNION ALL (SELECT * FROM forest_off EXCEPT SELECT * FROM forest_graph));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM tri_graph EXCEPT SELECT * FROM tri_off) UNION ALL (SELECT * FROM tri_off EXCEPT SELECT * FROM tri_graph));
----
0

query II
SELECT (SELECT count(*) FROM unary_graph) > 0,
       (SELECT count(*) FROM ((SELECT * FROM unary_graph EXCEPT SELECT * FROM unary_off) UNION ALL (SELECT * FROM unary_off EXCEPT SELECT * FROM unary_graph))) = 0;
----
true	true

# --- the graph asks fewer prompts than the cross product has rows: the lifted leaf is evaluated per pair,
#     not per tuple (40 x 30 x 20 = 24,000 tuples; the three pair domains sum to 2,600)
statement ok
SELECT ai_local_cache_clear();

statement ok
SELECT ai_usage_reset();

statement ok
CREATE TABLE tri_again AS SELECT x, y, z FROM ta, tb, tc WHERE ai_filter('[p=30] ab? ' || x || ' ' || y) AND ai_filter('[p=30] bc? ' || y || ' ' || z) AND ai_filter('[p=30] ac? ' || x || ' ' || z);

query I
SELECT sum(llm_calls + cache_hits) <= 2600 FROM ai_usage();
----
true

# --- an OR anywhere in the tree still keeps the region: a leaf's falsity no longer kills its tuples
query II
EXPLAIN SELECT * FROM ta, tb, tc WHERE (ai_filter('[p=30] ab? ' || x || ' ' || y) OR ai_filter('[p=30] bc? ' || y || ' ' || z)) AND ai_filter('[p=30] ac? ' || x || ' ' || z);
----
physical_plan	<!REGEX>:(?s).*Ai Factor Graph.*

statement ok
CALL ai_mock_stop();
